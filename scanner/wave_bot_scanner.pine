//@version=5
// WaveBot Scanner - 8 Forex Pairs, MTF Confluence, Max 2 Positions
// Single chart monitors all 8 pairs. Alerts suppressed when 2 virtual
// positions are already open. Apply this indicator to one chart tab.

indicator("WaveBot Scanner",
     shorttitle = "WaveBot Scanner",
     overlay    = true,
     max_labels_count = 500)

// ---------- INPUTS ----------
gSym  = "Symbols"
gTF   = "Timeframes"
gLog  = "Logic"
gRisk = "Risk"
gSess = "Session"

sym1 = input.symbol("OANDA:EURUSD", "Pair 1", group=gSym)
sym2 = input.symbol("OANDA:GBPUSD", "Pair 2", group=gSym)
sym3 = input.symbol("OANDA:USDJPY", "Pair 3", group=gSym)
sym4 = input.symbol("OANDA:AUDUSD", "Pair 4", group=gSym)
sym5 = input.symbol("OANDA:USDCAD", "Pair 5", group=gSym)
sym6 = input.symbol("OANDA:NZDUSD", "Pair 6", group=gSym)
sym7 = input.symbol("OANDA:EURJPY", "Pair 7", group=gSym)
sym8 = input.symbol("OANDA:GBPJPY", "Pair 8", group=gSym)

scanTF = input.timeframe("60",  "Scan TF",  options=["15","30","60","120","240"], group=gTF)
htfTF  = input.timeframe("240", "HTF Trend",options=["60","120","240","360","D"], group=gTF)

minScore  = input.int(5, "Min Score (of 6)", minval=3, maxval=6, group=gLog)
adxThresh = input.float(22, "ADX Minimum",   minval=10, group=gLog)

tpPct   = input.float(3.0, "TP %", minval=0.5, step=0.1, group=gRisk)
slPct   = input.float(1.5, "SL %", minval=0.3, step=0.1, group=gRisk)
sizePct = input.float(30,  "Size %", minval=1, maxval=100, group=gRisk)
maxOpen = input.int(2, "Max Open Positions", minval=1, maxval=8, group=gRisk)

useSession = input.bool(true, "Session filter", group=gSess)
sessionStr = input.session("1200-1700", "Session", group=gSess)
noFriPM    = input.bool(true, "Block Friday after 15:00", group=gSess)

// ---------- POSITION ARRAYS (parallel, fixed size 8) ----------
var array<string> pSide  = array.new<string>(8, "")
var array<string> pSym   = array.new<string>(8, "")
var array<float>  pEntry = array.new<float>(8, na)
var array<float>  pSL    = array.new<float>(8, na)
var array<float>  pTP    = array.new<float>(8, na)

// ---------- HELPER FUNCTIONS (all at top level) ----------
pack() =>
    c  = close
    ef = ta.ema(close, 50)
    es = ta.ema(close, 200)
    r  = ta.rsi(close, 14)
    [ml, sl, mh] = ta.macd(close, 12, 26, 9)
    [dp, dm, ax] = ta.dmi(14, 14)
    skR = ta.stoch(close, high, low, 14)
    sk  = ta.sma(skR, 3)
    sd  = ta.sma(sk, 3)
    at  = ta.atr(14)
    aa  = ta.sma(at, 50)
    [c, ef, es, r, mh, ml, sl, ax, dp, dm, sk, sd, at, aa]

htfPack() =>
    [ta.ema(close, 50), ta.ema(close, 200)]

scoreSym(sym) =>
    [c, ef, es, r, mh, ml, sl, ax, dp, dm, sk, sd, at, aa] = request.security(sym, scanTF, pack(), lookahead=barmerge.lookahead_off)
    [hef, hes] = request.security(sym, htfTF, htfPack(), lookahead=barmerge.lookahead_off)

    htfBull = hef > hes and c > hes
    htfBear = hef < hes and c < hes
    volOk   = at < aa * 1.5

    lT = (ef > es and c > ef) ? 1 : 0
    lH = htfBull ? 1 : 0
    lR = (r >= 40 and r <= 65) ? 1 : 0
    lM = (ml > sl and mh > nz(mh[1], 0)) ? 1 : 0
    lA = (ax > adxThresh and dp > dm) ? 1 : 0
    lS = (sk > sd and sk < 80) ? 1 : 0
    lsc = lT + lH + lR + lM + lA + lS

    sT = (ef < es and c < ef) ? 1 : 0
    sH = htfBear ? 1 : 0
    sR = (r >= 35 and r <= 60) ? 1 : 0
    sM = (ml < sl and mh < nz(mh[1], 0)) ? 1 : 0
    sA = (ax > adxThresh and dm > dp) ? 1 : 0
    sS = (sk < sd and sk > 20) ? 1 : 0
    ssc = sT + sH + sR + sM + sA + sS

    lFire = lsc >= minScore and volOk
    sFire = ssc >= minScore and volOk
    [lFire, sFire, c, lsc, ssc, ax, r, volOk]

countOpen() =>
    n = 0
    for i = 0 to 7
        if array.get(pSide, i) != ""
            n += 1
    n

hasSym(s) =>
    found = false
    for i = 0 to 7
        if array.get(pSym, i) == s
            found := true
    found

emptySlot() =>
    idx = -1
    for i = 0 to 7
        if idx == -1 and array.get(pSide, i) == ""
            idx := i
    idx

// ---------- SCAN ALL 8 PAIRS ----------
[lf1, sf1, p1, l1, s1, a1, r1, v1] = scoreSym(sym1)
[lf2, sf2, p2, l2, s2, a2, r2, v2] = scoreSym(sym2)
[lf3, sf3, p3, l3, s3, a3, r3, v3] = scoreSym(sym3)
[lf4, sf4, p4, l4, s4, a4, r4, v4] = scoreSym(sym4)
[lf5, sf5, p5, l5, s5, a5, r5, v5] = scoreSym(sym5)
[lf6, sf6, p6, l6, s6, a6, r6, v6] = scoreSym(sym6)
[lf7, sf7, p7, l7, s7, a7, r7, v7] = scoreSym(sym7)
[lf8, sf8, p8, l8, s8, a8, r8, v8] = scoreSym(sym8)

// Build price lookup via explicit comparisons (no loops needed)
priceFor(s) =>
    float out = na
    if s == sym1
        out := p1
    if s == sym2
        out := p2
    if s == sym3
        out := p3
    if s == sym4
        out := p4
    if s == sym5
        out := p5
    if s == sym6
        out := p6
    if s == sym7
        out := p7
    if s == sym8
        out := p8
    out

// ---------- SESSION ----------
inSession = not useSession or not na(time(timeframe.period, sessionStr))
okFriday  = not (noFriPM and dayofweek == dayofweek.friday and hour >= 15)
timeOk    = inSession and okFriday

// ---------- EVALUATE EXITS ----------
for i = 0 to 7
    side = array.get(pSide, i)
    if side != ""
        sYm = array.get(pSym, i)
        px  = priceFor(sYm)
        sl  = array.get(pSL, i)
        tp  = array.get(pTP, i)
        hit = false
        reason = ""
        if not na(px)
            if side == "LONG"
                if px <= sl
                    hit := true
                    reason := "SL"
                if px >= tp
                    hit := true
                    reason := "TP"
            if side == "SHORT"
                if px >= sl
                    hit := true
                    reason := "SL"
                if px <= tp
                    hit := true
                    reason := "TP"
        if hit
            alert('{"action":"CLOSE","pair":"' + sYm + '","side":"' + side + '","reason":"' + reason + '","exit":' + str.tostring(px) + '}', alert.freq_once_per_bar_close)
            array.set(pSide,  i, "")
            array.set(pSym,   i, "")
            array.set(pEntry, i, na)
            array.set(pSL,    i, na)
            array.set(pTP,    i, na)

// ---------- OPEN NEW POSITIONS ----------
tryOpen(s, lFire, sFire, px) =>
    if timeOk and barstate.isconfirmed and countOpen() < maxOpen and not hasSym(s)
        slot = emptySlot()
        if slot >= 0
            if lFire
                sl = px * (1 - slPct / 100)
                tp = px * (1 + tpPct / 100)
                array.set(pSide,  slot, "LONG")
                array.set(pSym,   slot, s)
                array.set(pEntry, slot, px)
                array.set(pSL,    slot, sl)
                array.set(pTP,    slot, tp)
                alert('{"action":"BUY","pair":"' + s + '","entry":' + str.tostring(px) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"size_pct":' + str.tostring(sizePct) + '}', alert.freq_once_per_bar_close)
            if sFire and not lFire
                sl = px * (1 + slPct / 100)
                tp = px * (1 - tpPct / 100)
                array.set(pSide,  slot, "SHORT")
                array.set(pSym,   slot, s)
                array.set(pEntry, slot, px)
                array.set(pSL,    slot, sl)
                array.set(pTP,    slot, tp)
                alert('{"action":"SELL","pair":"' + s + '","entry":' + str.tostring(px) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"size_pct":' + str.tostring(sizePct) + '}', alert.freq_once_per_bar_close)
    0

dummy1 = tryOpen(sym1, lf1, sf1, p1)
dummy2 = tryOpen(sym2, lf2, sf2, p2)
dummy3 = tryOpen(sym3, lf3, sf3, p3)
dummy4 = tryOpen(sym4, lf4, sf4, p4)
dummy5 = tryOpen(sym5, lf5, sf5, p5)
dummy6 = tryOpen(sym6, lf6, sf6, p6)
dummy7 = tryOpen(sym7, lf7, sf7, p7)
dummy8 = tryOpen(sym8, lf8, sf8, p8)

// ---------- DASHBOARD HELPER (top-level function) ----------
drawRow(tbl, r, s, lf, sf, px, lsc, ssc, ax, rs, vo) =>
    sdTxt = lf ? "LONG" : sf ? "SHORT" : "-"
    sc = color.gray
    if lf
        sc := color.lime
    if sf
        sc := color.red
    scTxt = lf ? str.tostring(lsc) + "/6" : sf ? str.tostring(ssc) + "/6" : str.tostring(math.max(lsc, ssc)) + "/6"
    bg = hasSym(s) ? color.new(color.yellow, 70) : color.new(color.black, 100)
    table.cell(tbl, 0, r, s,                          bgcolor=bg, text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, r, sdTxt,                      bgcolor=bg, text_color=sc,          text_size=size.tiny)
    table.cell(tbl, 2, r, scTxt,                      bgcolor=bg, text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 3, r, str.tostring(px, "#.#####"),bgcolor=bg, text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 4, r, str.tostring(ax, "#.#"),    bgcolor=bg, text_color=ax > adxThresh ? color.lime : color.gray, text_size=size.tiny)
    table.cell(tbl, 5, r, str.tostring(rs, "#.#"),    bgcolor=bg, text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 6, r, vo ? "OK" : "HI",           bgcolor=bg, text_color=vo ? color.lime : color.red, text_size=size.tiny)

// ---------- DASHBOARD ----------
var table dash = table.new(position.top_right, 7, 11, border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(dash, 0, 0, "Pair",  bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "Side",  bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 0, "Score", bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.small)
    table.cell(dash, 3, 0, "Price", bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.small)
    table.cell(dash, 4, 0, "ADX",   bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.small)
    table.cell(dash, 5, 0, "RSI",   bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.small)
    table.cell(dash, 6, 0, "Vol",   bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.small)

    drawRow(dash, 1, sym1, lf1, sf1, p1, l1, s1, a1, r1, v1)
    drawRow(dash, 2, sym2, lf2, sf2, p2, l2, s2, a2, r2, v2)
    drawRow(dash, 3, sym3, lf3, sf3, p3, l3, s3, a3, r3, v3)
    drawRow(dash, 4, sym4, lf4, sf4, p4, l4, s4, a4, r4, v4)
    drawRow(dash, 5, sym5, lf5, sf5, p5, l5, s5, a5, r5, v5)
    drawRow(dash, 6, sym6, lf6, sf6, p6, l6, s6, a6, r6, v6)
    drawRow(dash, 7, sym7, lf7, sf7, p7, l7, s7, a7, r7, v7)
    drawRow(dash, 8, sym8, lf8, sf8, p8, l8, s8, a8, r8, v8)

    openN = countOpen()
    table.cell(dash, 0, 9,  "Open/Max", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 9,  str.tostring(openN) + "/" + str.tostring(maxOpen), bgcolor=color.new(color.gray, 50), text_color=openN >= maxOpen ? color.red : color.lime, text_size=size.tiny)
    table.cell(dash, 0, 10, "Session",  bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 10, timeOk ? "OPEN" : "CLOSED", bgcolor=color.new(color.gray, 50), text_color=timeOk ? color.lime : color.red, text_size=size.tiny)

// ---------- MASTER ALERT ----------
anyFire = (lf1 or sf1 or lf2 or sf2 or lf3 or sf3 or lf4 or sf4 or lf5 or sf5 or lf6 or sf6 or lf7 or sf7 or lf8 or sf8) and timeOk and countOpen() < maxOpen
alertcondition(anyFire, "WaveBot ANY signal", "WaveBot scanner fired a signal with capacity available")
