//@version=5
// WaveBot Strategy - Multi-Indicator Confluence for Forex
// TP 3% | SL 1.5% | Size 30% | Max 1 position per chart
// Apply on H1 timeframe. HTF trend filter uses H4 by default.

strategy("WaveBot Strategy",
     shorttitle       = "WaveBot Strat",
     overlay          = true,
     initial_capital  = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value= 30,
     pyramiding       = 0,
     commission_type  = strategy.commission.percent,
     commission_value = 0.02,
     slippage         = 2,
     process_orders_on_close = true,
     calc_on_every_tick      = false)

// ---------- INPUTS ----------
gCore   = "Core"
gRisk   = "Risk"
gFilt   = "Filters"
gSess   = "Session"

htfInput    = input.timeframe("240", "Higher TF", options=["60","120","240","360","D"], group=gCore)
minScore    = input.int(5, "Min Confluence Score", minval=3, maxval=6, group=gCore)

tpPct       = input.float(3.0, "TP %",  minval=0.5, step=0.1, group=gRisk)
slPct       = input.float(1.5, "SL %",  minval=0.3, step=0.1, group=gRisk)
useTrail    = input.bool(true, "Enable ATR Trailing Stop", group=gRisk)
trailMult   = input.float(2.0, "Trail ATR Multiplier", minval=0.5, step=0.1, group=gRisk)
trailActPct = input.float(1.2, "Activate Trail After (% profit)", minval=0.1, step=0.1, group=gRisk)

emaFast     = input.int(50,  "EMA Fast", minval=5,  group=gFilt)
emaSlow     = input.int(200, "EMA Slow", minval=20, group=gFilt)
rsiLen      = input.int(14,  "RSI Length", minval=2, group=gFilt)
adxLen      = input.int(14,  "ADX Length", minval=5, group=gFilt)
adxThresh   = input.float(22, "ADX Minimum", minval=10, group=gFilt)
atrMaxMult  = input.float(1.5,"Max ATR vs 50-avg", minval=1, step=0.1, group=gFilt)

useSession  = input.bool(true, "Session filter", group=gSess)
sessionStr  = input.session("1200-1700", "Session", group=gSess)
noFriPM     = input.bool(true, "Block Friday after 15:00", group=gSess)
cooldown    = input.int(3, "Cooldown bars", minval=0, group=gSess)

// ---------- CURRENT-TF INDICATORS ----------
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
rsi  = ta.rsi(close, rsiLen)

[macdLine, sigLine, macdHist] = ta.macd(close, 12, 26, 9)
[diPlus, diMinus, adx]        = ta.dmi(adxLen, adxLen)

atrV   = ta.atr(14)
atrAvg = ta.sma(atrV, 50)
stKRaw = ta.stoch(close, high, low, 14)
stK    = ta.sma(stKRaw, 3)
stD    = ta.sma(stK, 3)

// ---------- HTF TREND (wrapped to avoid tuple-index bug) ----------
htfCalc() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    [ef, es]

[htfEmaF, htfEmaS] = request.security(syminfo.tickerid, htfInput, htfCalc(), lookahead=barmerge.lookahead_off)

htfBull = htfEmaF > htfEmaS and close > htfEmaS
htfBear = htfEmaF < htfEmaS and close < htfEmaS

// ---------- SESSION / COOLDOWN ----------
inSession = not useSession or not na(time(timeframe.period, sessionStr))
okFriday  = not (noFriPM and dayofweek == dayofweek.friday and hour >= 15)
timeOk    = inSession and okFriday

var int lastExitBar = -1000
cooldownOk = (bar_index - lastExitBar) > cooldown

// ---------- SCORING ----------
volOk = atrV < atrAvg * atrMaxMult

lTrend = (emaF > emaS and close > emaF) ? 1 : 0
lHtf   = htfBull ? 1 : 0
lRsi   = (rsi >= 40 and rsi <= 65) ? 1 : 0
lMacd  = (macdLine > sigLine and macdHist > nz(macdHist[1], 0)) ? 1 : 0
lAdx   = (adx > adxThresh and diPlus > diMinus) ? 1 : 0
lStoch = (ta.crossover(stK, stD) and stK < 80) ? 1 : 0
longScore = lTrend + lHtf + lRsi + lMacd + lAdx + lStoch

sTrend = (emaF < emaS and close < emaF) ? 1 : 0
sHtf   = htfBear ? 1 : 0
sRsi   = (rsi >= 35 and rsi <= 60) ? 1 : 0
sMacd  = (macdLine < sigLine and macdHist < nz(macdHist[1], 0)) ? 1 : 0
sAdx   = (adx > adxThresh and diMinus > diPlus) ? 1 : 0
sStoch = (ta.crossunder(stK, stD) and stK > 20) ? 1 : 0
shortScore = sTrend + sHtf + sRsi + sMacd + sAdx + sStoch

// ---------- ENTRY ----------
flat       = strategy.position_size == 0
longSig    = longScore  >= minScore and volOk and timeOk and cooldownOk and flat
shortSig   = shortScore >= minScore and volOk and timeOk and cooldownOk and flat

var float entryP = na
var float slP    = na
var float tpP    = na
var float trailP = na
var bool  trailOn = false

if longSig
    entryP  := close
    slP     := close * (1 - slPct / 100)
    tpP     := close * (1 + tpPct / 100)
    trailP  := slP
    trailOn := false
    strategy.entry("LONG", strategy.long)

if shortSig
    entryP  := close
    slP     := close * (1 + slPct / 100)
    tpP     := close * (1 - tpPct / 100)
    trailP  := slP
    trailOn := false
    strategy.entry("SHORT", strategy.short)

// ---------- TRAILING STOP ----------
if useTrail and strategy.position_size > 0 and not na(entryP)
    profitPct = (close - entryP) / entryP * 100
    if profitPct >= trailActPct
        trailOn := true
    if trailOn
        newT = close - atrV * trailMult
        trailP := math.max(nz(trailP, newT), newT)

if useTrail and strategy.position_size < 0 and not na(entryP)
    profitPct = (entryP - close) / entryP * 100
    if profitPct >= trailActPct
        trailOn := true
    if trailOn
        newT = close + atrV * trailMult
        trailP := math.min(nz(trailP, newT), newT)

// ---------- EXIT ----------
effLongSL  = (useTrail and trailOn) ? math.max(slP, trailP) : slP
effShortSL = (useTrail and trailOn) ? math.min(slP, trailP) : slP

if strategy.position_size > 0
    strategy.exit("Exit Long",  "LONG",  stop=effLongSL,  limit=tpP)

if strategy.position_size < 0
    strategy.exit("Exit Short", "SHORT", stop=effShortSL, limit=tpP)

// Record exit bar for cooldown
if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index

// ---------- PLOTS ----------
plot(emaF, "EMA Fast", color=color.new(color.aqua,   0))
plot(emaS, "EMA Slow", color=color.new(color.orange, 0), linewidth=2)

plotshape(longSig,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small, text="BUY")
plotshape(shortSig, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small, text="SELL")

plot(strategy.position_size != 0 ? tpP : na, "TP", color=color.green, style=plot.style_linebr)
plot(strategy.position_size > 0 ? effLongSL : strategy.position_size < 0 ? effShortSL : na, "SL", color=color.red, style=plot.style_linebr)

bgcolor(timeOk ? na : color.new(color.gray, 92))

// ---------- ALERTS ----------
alertcondition(longSig,  "WaveBot LONG",  "WaveBot LONG {{ticker}} @ {{close}}")
alertcondition(shortSig, "WaveBot SHORT", "WaveBot SHORT {{ticker}} @ {{close}}")
