//@version=5
// =============================================================================
//  DBB Crypto - Double Bollinger Bands tuned for 24/7 high-volatility markets
// =============================================================================
//  המחקר ציין שלקריפטו יש "Fat Tails" - מהלכי 4-סיגמה הופכים ליומיומיים.
//  לכן הסקריפט מותאם:
//  - סיגמא מורחבת ל-6 (במקום 4) ברצועה האדומה
//  - אין סינון שעות (קריפטו 24/7)
//  - מסגרות זמן מועדפות: M15 / H1 / H4
//  - מתאים לזוגות ראשיים: BTC/USDT, ETH/USDT, SOL/USDT
//  - הגנה מוגברת מ-Wicks (אישור Wick rejection חזק)
//  - אזהרה לפני אירועי תנודתיות חריגה (Funding rate, halving וכו')
// =============================================================================

strategy("DBB Crypto",
     shorttitle             = "DBB-CR",
     overlay                = true,
     initial_capital        = 10000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 20,
     pyramiding             = 0,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.075,
     slippage               = 3,
     process_orders_on_close= true,
     calc_on_every_tick     = false)

// ---------- INPUTS ----------
gBB    = "Double Bollinger (Crypto-tuned)"
gFilt  = "Filters"
gRisk  = "Risk Management"

redLen    = input.int(4,  "Red BB Length", minval=2, group=gBB)
redMult   = input.float(6.0, "Red BB StdDev (6σ for crypto fat-tails)", minval=3.0, step=0.1, group=gBB)
whiteLen  = input.int(20, "White BB Length", minval=10, group=gBB)
whiteMult = input.float(2.0, "White BB StdDev", minval=1.0, step=0.1, group=gBB)

htfInput     = input.timeframe("240", "HTF for trend bias", options=["60","240","D","W"], group=gFilt)
rsiLen       = input.int(14, "RSI Length", minval=2, group=gFilt)
rsiLongMax   = input.float(28, "RSI Long Max (deep oversold)", minval=10, maxval=45, group=gFilt)
rsiShortMin  = input.float(72, "RSI Short Min (extreme OB)",   minval=55, maxval=90, group=gFilt)
useVolume    = input.bool(true, "Require volume burst", group=gFilt)
volMult      = input.float(1.5, "Volume multiplier vs 20-avg", minval=1.0, step=0.1, group=gFilt)
useATRFilter = input.bool(true, "Require ATR expansion (real burst, not wick)", group=gFilt)
atrMult      = input.float(1.4, "Current ATR vs 50-avg", minval=1.0, step=0.1, group=gFilt)
useSqueezeBlock = input.bool(true, "Block during White-BB squeeze", group=gFilt)
squeezeMinPct   = input.float(1.5, "Min White-BB width (% of price)", minval=0.3, step=0.1, group=gFilt)
useWeekendSkip  = input.bool(false, "Skip weekends (manipulation hours)", group=gFilt)

riskPct    = input.float(1.0, "Risk per trade %", minval=0.1, step=0.1, group=gRisk)
leverage   = input.float(3.0, "Leverage (crypto: keep modest!)", minval=1.0, maxval=10.0, step=0.5, group=gRisk)
slBuffer   = input.float(0.5, "SL buffer (× sigma)", minval=0.0, step=0.1, group=gRisk)
maxLossPct = input.float(3.0, "Hard SL cap (%)", minval=0.5, step=0.1, group=gRisk)
useTP1Half = input.bool(true, "Close 50% at MA20 (TP1)", group=gRisk)
useBE      = input.bool(true, "Move SL to BE after TP1", group=gRisk)
useTrailAtr= input.bool(true, "ATR-trail remainder after TP1", group=gRisk)
trailMult  = input.float(2.5, "ATR-trail multiplier", minval=0.5, step=0.1, group=gRisk)
cooldown   = input.int(4, "Cooldown bars after exit", minval=0, group=gRisk)

// ---------- DOUBLE BOLLINGER BANDS ----------
redBasis   = ta.sma(open,  redLen)
redDev     = ta.stdev(open, redLen) * redMult
redUpper   = redBasis + redDev
redLower   = redBasis - redDev

whiteBasis = ta.sma(close, whiteLen)
whiteDev   = ta.stdev(close, whiteLen) * whiteMult
whiteUpper = whiteBasis + whiteDev
whiteLower = whiteBasis - whiteDev

// ---------- HTF TREND BIAS ----------
htfTrend() =>
    wb = ta.sma(close, whiteLen)
    [wb, close]
[htfBasis, htfClose] = request.security(syminfo.tickerid, htfInput, htfTrend(), lookahead=barmerge.lookahead_off)
htfBull = htfClose > htfBasis
htfBear = htfClose < htfBasis

// ---------- INDICATORS ----------
rsi    = ta.rsi(close, rsiLen)
volAvg = ta.sma(volume, 20)
volOk  = not useVolume or volume > volAvg * volMult

atrV   = ta.atr(14)
atrAvg = ta.sma(atrV, 50)
atrOk  = not useATRFilter or atrV > atrAvg * atrMult

bbWidthPct = (whiteUpper - whiteLower) / whiteBasis * 100
notSqueezed = not useSqueezeBlock or bbWidthPct >= squeezeMinPct

isWeekend = dayofweek == dayofweek.saturday or dayofweek == dayofweek.sunday
timeOk    = not useWeekendSkip or not isWeekend

var int lastExitBar = -1000
cooldownOk = (bar_index - lastExitBar) > cooldown

// ---------- SIGNALS (strong wick-rejection for crypto) ----------
touchedLower = low  <= redLower
touchedUpper = high >= redUpper

barRange   = high - low
// Lower-wick rejection of >50% of bar AND close above lower red band
bullStrong = touchedLower and close > open and (close - low) / barRange > 0.55 and close > redLower
// Upper-wick rejection of >50% of bar AND close below upper red band
bearStrong = touchedUpper and close < open and (high - close) / barRange > 0.55 and close < redUpper

flat     = strategy.position_size == 0
filters  = volOk and atrOk and notSqueezed and timeOk and cooldownOk and flat
longSig  = bullStrong and rsi < rsiLongMax  and htfBull and filters
shortSig = bearStrong and rsi > rsiShortMin and htfBear and filters

// ---------- ORDERS ----------
var float entryP  = na
var float slP     = na
var float tp1P    = na
var float tp2P    = na
var bool  beMoved = false
var bool  trailOn = false

sigmaSize = redDev / redMult

if longSig
    entryP := close
    slCalc  = redLower - sigmaSize * slBuffer
    slCap   = entryP * (1 - maxLossPct / 100)
    slP    := math.max(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteUpper
    beMoved := false
    trailOn := false
    risk = entryP - slP
    rawQty = risk > 0 ? (strategy.equity * riskPct / 100) / risk : na
    maxQty = strategy.equity * leverage / entryP
    qty    = math.min(rawQty, maxQty)
    strategy.entry("LONG", strategy.long, qty=qty)

if shortSig
    entryP := close
    slCalc  = redUpper + sigmaSize * slBuffer
    slCap   = entryP * (1 + maxLossPct / 100)
    slP    := math.min(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteLower
    beMoved := false
    trailOn := false
    risk = slP - entryP
    rawQty = risk > 0 ? (strategy.equity * riskPct / 100) / risk : na
    maxQty = strategy.equity * leverage / entryP
    qty    = math.min(rawQty, maxQty)
    strategy.entry("SHORT", strategy.short, qty=qty)

// Move SL to BE after TP1
if useBE and not beMoved
    if strategy.position_size > 0 and high >= tp1P
        slP := entryP
        beMoved := true
        trailOn := useTrailAtr
    if strategy.position_size < 0 and low <= tp1P
        slP := entryP
        beMoved := true
        trailOn := useTrailAtr

// ATR-trail the remainder
if trailOn and strategy.position_size > 0
    newT = close - atrV * trailMult
    slP := math.max(slP, newT)
if trailOn and strategy.position_size < 0
    newT = close + atrV * trailMult
    slP := math.min(slP, newT)

if strategy.position_size > 0
    if useTP1Half and not beMoved
        strategy.exit("TP1-L", "LONG", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-L", "LONG", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-L",  "LONG", limit=tp2P, stop=slP)

if strategy.position_size < 0
    if useTP1Half and not beMoved
        strategy.exit("TP1-S", "SHORT", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-S", "SHORT", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-S",  "SHORT", limit=tp2P, stop=slP)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index

// ---------- PLOTS ----------
plot(redUpper,   "Red Upper (6σ)", color=color.new(color.red, 10))
plot(redLower,   "Red Lower (6σ)", color=color.new(color.red, 10))
plot(whiteUpper, "White Upper",    color=color.new(color.white, 0))
plot(whiteLower, "White Lower",    color=color.new(color.white, 0))
plot(whiteBasis, "MA20 (TP1)",     color=color.new(color.yellow, 0), linewidth=2)

plotshape(longSig,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small, text="BUY")
plotshape(shortSig, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small, text="SELL")

bgcolor(notSqueezed ? na : color.new(color.purple, 90))
bgcolor(timeOk ? na : color.new(color.gray, 92))

alertcondition(longSig,  "DBB Crypto LONG",  "DBB Crypto LONG {{ticker}} @ {{close}}")
alertcondition(shortSig, "DBB Crypto SHORT", "DBB Crypto SHORT {{ticker}} @ {{close}}")
