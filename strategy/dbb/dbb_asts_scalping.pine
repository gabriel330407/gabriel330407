//@version=5
// =============================================================================
//  DBB ASTS Scalping - Tuned for AST SpaceMobile (high-volatility small-cap)
// =============================================================================
//  מותאם ספציפית למניית $ASTS:
//  - תנודתיות יומית גבוהה (~8-15% std), נטיה ל"גאפים" וזינוקים על חדשות
//  - מסגרת זמן: M5 (ברירת מחדל) / M3
//  - סיגמא מורחבת ל-5 (במקום 4) כדי לפצות על "Fat Tails" של המניה
//  - RSI מעט פחות אקסטרים כדי לא לפספס היפוכים מהירים
//  - חובה: אישור נר + נפח גבוה במיוחד
//  - חובה: סגירה לפני סוף יום (אין החזקה לילית - גאפים יכולים להרוס סטופ)
// =============================================================================

strategy("DBB ASTS Scalping",
     shorttitle             = "DBB-ASTS",
     overlay                = true,
     initial_capital        = 10000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 15,
     pyramiding             = 0,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.03,
     slippage               = 3,
     process_orders_on_close= true,
     calc_on_every_tick     = false)

// ---------- INPUTS ----------
gBB    = "Double Bollinger (ASTS-tuned)"
gFilt  = "Filters"
gRisk  = "Risk (Aggressive Scalp)"
gSess  = "Session (NY RTH)"

redLen    = input.int(4,  "Red BB Length",   minval=2, group=gBB)
redMult   = input.float(5.0, "Red BB StdDev (5σ for ASTS)", minval=3.0, step=0.1, group=gBB)
whiteLen  = input.int(20, "White BB Length", minval=10, group=gBB)
whiteMult = input.float(2.0, "White BB StdDev", minval=1.0, step=0.1, group=gBB)

htfInput     = input.timeframe("60", "HTF for trend bias", options=["15","60","240","D"], group=gFilt)
rsiLen       = input.int(14, "RSI Length", minval=2, group=gFilt)
rsiLongMax   = input.float(30, "RSI Long Max (oversold)",  minval=10, maxval=45, group=gFilt)
rsiShortMin  = input.float(70, "RSI Short Min (overbought)", minval=55, maxval=90, group=gFilt)
volMult      = input.float(1.8, "Required volume vs 20-avg (ASTS needs >1.5x)", minval=1.0, step=0.1, group=gFilt)
useATRFilter = input.bool(true, "Require ATR expansion (real volatility burst)", group=gFilt)
atrMult      = input.float(1.3, "Current ATR vs 50-avg",   minval=1.0, step=0.1, group=gFilt)
useSqueezeBlock = input.bool(true, "Block during White-BB squeeze", group=gFilt)
squeezeMinPct   = input.float(1.0, "Min White-BB width (% of price)", minval=0.2, step=0.1, group=gFilt)

riskPct    = input.float(0.75, "Risk per trade % (small for ASTS)", minval=0.1, step=0.1, group=gRisk)
leverage   = input.float(2.0,  "Leverage (low - ASTS too volatile)", minval=1.0, maxval=4.0, step=0.5, group=gRisk)
slBuffer   = input.float(0.4,  "SL buffer (× sigma)", minval=0.0, step=0.1, group=gRisk)
maxLossPct = input.float(2.5,  "Hard SL cap (%)", minval=0.5, step=0.1, group=gRisk)
useTP1Half = input.bool(true,  "Close 50% at MA20 (TP1)", group=gRisk)
useBE      = input.bool(true,  "Move SL to BE after TP1", group=gRisk)

sessionStr = input.session("0945-1530", "Avoid first 15min + last 30min", group=gSess)
eodTime    = input.session("1545-1600", "EOD force-exit window", group=gSess)
cooldown   = input.int(3, "Cooldown bars after exit", minval=0, group=gSess)

// ---------- VALIDATE TICKER (warning only) ----------
isAsts = str.contains(syminfo.ticker, "ASTS")
if barstate.islast and not isAsts
    label.new(bar_index, high, "⚠️ Script tuned for $ASTS - current symbol: " + syminfo.ticker, color=color.orange, textcolor=color.white, style=label.style_label_down)

// ---------- DOUBLE BOLLINGER BANDS ----------
redBasis   = ta.sma(open,  redLen)
redDev     = ta.stdev(open, redLen) * redMult
redUpper   = redBasis + redDev
redLower   = redBasis - redDev

whiteBasis = ta.sma(close, whiteLen)
whiteDev   = ta.stdev(close, whiteLen) * whiteMult
whiteUpper = whiteBasis + whiteDev
whiteLower = whiteBasis - whiteDev

// ---------- HTF TREND BIAS ----------
htfTrend() =>
    wb = ta.sma(close, whiteLen)
    [wb, close]
[htfBasis, htfClose] = request.security(syminfo.tickerid, htfInput, htfTrend(), lookahead=barmerge.lookahead_off)
htfBull = htfClose > htfBasis
htfBear = htfClose < htfBasis

// ---------- INDICATORS ----------
rsi    = ta.rsi(close, rsiLen)
volAvg = ta.sma(volume, 20)
volOk  = volume > volAvg * volMult

atrV   = ta.atr(14)
atrAvg = ta.sma(atrV, 50)
atrOk  = not useATRFilter or atrV > atrAvg * atrMult

bbWidthPct = (whiteUpper - whiteLower) / whiteBasis * 100
notSqueezed = not useSqueezeBlock or bbWidthPct >= squeezeMinPct

inSession = not na(time(timeframe.period, sessionStr))
inEOD     = not na(time(timeframe.period, eodTime))

var int lastExitBar = -1000
cooldownOk = (bar_index - lastExitBar) > cooldown

// ---------- SIGNALS (strict for ASTS) ----------
touchedLower = low  <= redLower
touchedUpper = high >= redUpper

// Require strong reversal candle (not just close-back-inside, but >50% retrace of the bar)
barRange     = high - low
bullStrong   = touchedLower and close > open and (close - low) / barRange > 0.6 and close > redLower
bearStrong   = touchedUpper and close < open and (high - close) / barRange > 0.6 and close < redUpper

flat     = strategy.position_size == 0
allFilt  = volOk and atrOk and notSqueezed and inSession and cooldownOk and flat
longSig  = bullStrong and rsi < rsiLongMax  and htfBull and allFilt
shortSig = bearStrong and rsi > rsiShortMin and htfBear and allFilt

// ---------- ORDERS ----------
var float entryP = na
var float slP    = na
var float tp1P   = na
var float tp2P   = na
var bool  beMoved = false

sigmaSize = redDev / redMult

if longSig
    entryP := close
    slCalc  = redLower - sigmaSize * slBuffer
    slCap   = entryP * (1 - maxLossPct / 100)
    slP    := math.max(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteUpper
    beMoved := false
    risk = entryP - slP
    rawQty = risk > 0 ? (strategy.equity * riskPct / 100) / risk : na
    maxQty = strategy.equity * leverage / entryP
    qty    = math.min(rawQty, maxQty)
    strategy.entry("LONG", strategy.long, qty=qty)

if shortSig
    entryP := close
    slCalc  = redUpper + sigmaSize * slBuffer
    slCap   = entryP * (1 + maxLossPct / 100)
    slP    := math.min(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteLower
    beMoved := false
    risk = slP - entryP
    rawQty = risk > 0 ? (strategy.equity * riskPct / 100) / risk : na
    maxQty = strategy.equity * leverage / entryP
    qty    = math.min(rawQty, maxQty)
    strategy.entry("SHORT", strategy.short, qty=qty)

if useBE and not beMoved
    if strategy.position_size > 0 and high >= tp1P
        slP := entryP
        beMoved := true
    if strategy.position_size < 0 and low <= tp1P
        slP := entryP
        beMoved := true

if strategy.position_size > 0
    if useTP1Half and not beMoved
        strategy.exit("TP1-L", "LONG", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-L", "LONG", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-L",  "LONG", limit=tp2P, stop=slP)

if strategy.position_size < 0
    if useTP1Half and not beMoved
        strategy.exit("TP1-S", "SHORT", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-S", "SHORT", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-S",  "SHORT", limit=tp2P, stop=slP)

if inEOD and strategy.position_size != 0
    strategy.close_all(comment="EOD-NoGapRisk")

if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index

// ---------- PLOTS ----------
plot(redUpper,   "Red Upper (5σ)", color=color.new(color.red, 10))
plot(redLower,   "Red Lower (5σ)", color=color.new(color.red, 10))
plot(whiteUpper, "White Upper",    color=color.new(color.white, 0))
plot(whiteLower, "White Lower",    color=color.new(color.white, 0))
plot(whiteBasis, "MA20 (TP1)",     color=color.new(color.yellow, 0), linewidth=2)

plotshape(longSig,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small, text="BUY")
plotshape(shortSig, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small, text="SELL")

bgcolor(inSession ? na : color.new(color.gray, 92))
bgcolor(notSqueezed ? na : color.new(color.purple, 90))

alertcondition(longSig,  "DBB ASTS LONG",  "DBB ASTS LONG {{ticker}} @ {{close}} vol={{volume}}")
alertcondition(shortSig, "DBB ASTS SHORT", "DBB ASTS SHORT {{ticker}} @ {{close}} vol={{volume}}")
