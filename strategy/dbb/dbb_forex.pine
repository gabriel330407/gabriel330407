//@version=5
// =============================================================================
//  DBB Forex Strategy - Double Bollinger Bands (4,4,Open) + (20,2,Close)
// =============================================================================
//  שיטה מהמחקר: Hybrid Top-Down Analysis
//  - מסגרת זמן ביצוע: M15 (5 דקות אופציה לסוחר מתקדם)
//  - מסגרת זמן מגמה גבוהה: H4 (סינון כיוון לפי הרצועה הלבנה ב-HTF)
//  - מסחר על צמדי מטח ראשיים (EURUSD, GBPUSD, USDJPY, AUDUSD ...)
//  - יש להריץ במהלך חפיפת לונדון-ניו יורק (12:00-17:00 GMT) להימנע מחדשות רועשות
//  אסטרטגיית כניסה: Extreme Mean Reversion
//  - Long: נגיעה ברצועה האדומה התחתונה + סגירה בחזרה לתוך הרצועה + RSI<30
//  - Short: נגיעה ברצועה האדומה העליונה + סגירה בחזרה לתוך הרצועה + RSI>70
//  יציאה: TP1 = MA20 (לבן אמצעי) | TP2 = רצועה לבנה נגדית | SL = מעבר לרצועה האדומה
// =============================================================================

strategy("DBB Forex",
     shorttitle             = "DBB-FX",
     overlay                = true,
     initial_capital        = 10000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 15,
     pyramiding             = 0,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.01,
     slippage               = 1,
     process_orders_on_close= true,
     calc_on_every_tick     = false)

// ---------- INPUTS ----------
gBB    = "Double Bollinger"
gFilt  = "Filters"
gRisk  = "Risk Management"
gSess  = "Session (London-NY overlap)"

redLen   = input.int(4,  "Red BB Length",   minval=2, group=gBB)
redMult  = input.float(4.0, "Red BB StdDev", minval=2.0, step=0.1, group=gBB)
whiteLen = input.int(20, "White BB Length", minval=10, group=gBB)
whiteMult= input.float(2.0, "White BB StdDev", minval=1.0, step=0.1, group=gBB)

htfInput   = input.timeframe("240", "HTF for trend bias", options=["60","240","D"], group=gFilt)
rsiLen     = input.int(14, "RSI Length", minval=2, group=gFilt)
rsiLongMax = input.float(35, "RSI Long Max",  minval=10, maxval=50, group=gFilt)
rsiShortMin= input.float(65, "RSI Short Min", minval=50, maxval=90, group=gFilt)
useSqueezeBlock = input.bool(true, "Block trades during White-BB squeeze", group=gFilt)
squeezeMinPct   = input.float(0.25, "Min White-BB width (% of price)", minval=0.05, step=0.05, group=gFilt)

riskPct    = input.float(1.5,  "Risk per trade %",   minval=0.1, step=0.1, group=gRisk)
slBuffer   = input.float(0.5,  "SL buffer (× sigma beyond red band)", minval=0.0, step=0.1, group=gRisk)
useTP1Half = input.bool(true,  "Close 50% at MA20 (TP1)", group=gRisk)
maxLossPct = input.float(2.0,  "Hard SL cap (% of price)", minval=0.3, step=0.1, group=gRisk)

useSession = input.bool(true,  "Session filter", group=gSess)
sessionStr = input.session("1200-1700", "Session", group=gSess)
noFriPM    = input.bool(true,  "Block Friday after 15:00", group=gSess)
cooldown   = input.int(3, "Cooldown bars after exit", minval=0, group=gSess)

// ---------- DOUBLE BOLLINGER BANDS ----------
redBasis   = ta.sma(open,  redLen)
redDev     = ta.stdev(open, redLen) * redMult
redUpper   = redBasis + redDev
redLower   = redBasis - redDev

whiteBasis = ta.sma(close, whiteLen)
whiteDev   = ta.stdev(close, whiteLen) * whiteMult
whiteUpper = whiteBasis + whiteDev
whiteLower = whiteBasis - whiteDev

// ---------- HTF TREND BIAS (white BB on HTF) ----------
htfTrend() =>
    wb = ta.sma(close, whiteLen)
    [wb, close]

[htfBasis, htfClose] = request.security(syminfo.tickerid, htfInput, htfTrend(), lookahead=barmerge.lookahead_off)
htfBull = htfClose > htfBasis
htfBear = htfClose < htfBasis

// ---------- INDICATORS ----------
rsi = ta.rsi(close, rsiLen)

// White BB squeeze detection (avoid trading inside a coiling market)
bbWidthPct = (whiteUpper - whiteLower) / whiteBasis * 100
notSqueezed = not useSqueezeBlock or bbWidthPct >= squeezeMinPct

// ---------- SESSION / COOLDOWN ----------
inSession = not useSession or not na(time(timeframe.period, sessionStr))
okFriday  = not (noFriPM and dayofweek == dayofweek.friday and hour >= 15)
timeOk    = inSession and okFriday

var int lastExitBar = -1000
cooldownOk = (bar_index - lastExitBar) > cooldown

// ---------- ENTRY SIGNALS ----------
// Tag a bar as "touched" if low pierced lower red band, and confirmation candle closes back inside
touchedLower = low  <= redLower
touchedUpper = high >= redUpper

bullReversal = touchedLower and close > open and close > redLower
bearReversal = touchedUpper and close < open and close < redUpper

flat = strategy.position_size == 0

longSig  = bullReversal and rsi < rsiLongMax  and htfBull and notSqueezed and timeOk and cooldownOk and flat
shortSig = bearReversal and rsi > rsiShortMin and htfBear and notSqueezed and timeOk and cooldownOk and flat

// ---------- POSITION SIZING (risk-based) ----------
var float entryP = na
var float slP    = na
var float tp1P   = na
var float tp2P   = na

sigmaSize = redDev / redMult  // 1 sigma in price units

if longSig
    entryP := close
    slCalc  = redLower - sigmaSize * slBuffer
    slCap   = entryP * (1 - maxLossPct / 100)
    slP    := math.max(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteUpper
    riskPerUnit = entryP - slP
    qty = riskPerUnit > 0 ? (strategy.equity * riskPct / 100) / riskPerUnit : na
    strategy.entry("LONG", strategy.long, qty=qty)

if shortSig
    entryP := close
    slCalc  = redUpper + sigmaSize * slBuffer
    slCap   = entryP * (1 + maxLossPct / 100)
    slP    := math.min(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteLower
    riskPerUnit = slP - entryP
    qty = riskPerUnit > 0 ? (strategy.equity * riskPct / 100) / riskPerUnit : na
    strategy.entry("SHORT", strategy.short, qty=qty)

// ---------- EXITS (scale out at TP1, run rest to TP2) ----------
if strategy.position_size > 0
    if useTP1Half
        strategy.exit("TP1-L", "LONG", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-L", "LONG", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-L",  "LONG", limit=tp2P, stop=slP)

if strategy.position_size < 0
    if useTP1Half
        strategy.exit("TP1-S", "SHORT", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-S", "SHORT", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-S",  "SHORT", limit=tp2P, stop=slP)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index

// ---------- PLOTS ----------
plot(redUpper,   "Red Upper",   color=color.new(color.red, 20))
plot(redLower,   "Red Lower",   color=color.new(color.red, 20))
plot(redBasis,   "Red Basis",   color=color.new(color.red, 60), display=display.none)

plot(whiteUpper, "White Upper", color=color.new(color.white, 0), linewidth=1)
plot(whiteLower, "White Lower", color=color.new(color.white, 0), linewidth=1)
plot(whiteBasis, "MA20 (TP1)",  color=color.new(color.yellow, 0), linewidth=2)

plotshape(longSig,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small, text="BUY")
plotshape(shortSig, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small, text="SELL")

bgcolor(timeOk ? na : color.new(color.gray, 92))
bgcolor(notSqueezed ? na : color.new(color.purple, 90))

// ---------- ALERTS ----------
alertcondition(longSig,  "DBB FX LONG",  "DBB FX LONG {{ticker}} @ {{close}}")
alertcondition(shortSig, "DBB FX SHORT", "DBB FX SHORT {{ticker}} @ {{close}}")
