//@version=5
// =============================================================================
//  DBB Stocks Scalping - Double Bollinger Bands (4,4,Open) + (20,2,Close)
// =============================================================================
//  מסחר מנייתי / סקאלפינג עם מינוף מתון (X2 - X5)
//  - מסגרת זמן: M5 / M15 (ברירת מחדל M5)
//  - מניות לארג'-קאפ נזילות (AAPL, MSFT, NVDA, TSLA, GOOGL, META, AMZN)
//  - מצב סקאלפינג: יציאה מהירה לממוצע MA20 (TP1), חצי פוזיציה ל-TP2
//  - מסחר רק בשעות הרגילות (RTH) - 9:30-16:00 NY
// =============================================================================

strategy("DBB Stocks Scalping",
     shorttitle             = "DBB-SC",
     overlay                = true,
     initial_capital        = 10000,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 20,
     pyramiding             = 0,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.03,
     slippage               = 2,
     process_orders_on_close= true,
     calc_on_every_tick     = false)

// ---------- INPUTS ----------
gBB    = "Double Bollinger"
gFilt  = "Filters"
gRisk  = "Risk (Scalping)"
gSess  = "Session"

redLen   = input.int(4,  "Red BB Length",   minval=2, group=gBB)
redMult  = input.float(4.0, "Red BB StdDev", minval=2.0, step=0.1, group=gBB)
whiteLen = input.int(20, "White BB Length", minval=10, group=gBB)
whiteMult= input.float(2.0, "White BB StdDev", minval=1.0, step=0.1, group=gBB)

htfInput   = input.timeframe("60", "HTF for trend bias", options=["15","60","240","D"], group=gFilt)
rsiLen     = input.int(14, "RSI Length", minval=2, group=gFilt)
rsiLongMax = input.float(35, "RSI Long Max",  minval=10, maxval=50, group=gFilt)
rsiShortMin= input.float(65, "RSI Short Min", minval=50, maxval=90, group=gFilt)
useVolume  = input.bool(true, "Require above-avg volume on signal", group=gFilt)
volMult    = input.float(1.2, "Volume multiplier vs 20-avg", minval=1.0, step=0.1, group=gFilt)
useSqueezeBlock = input.bool(true, "Block trades during White-BB squeeze", group=gFilt)
squeezeMinPct   = input.float(0.4, "Min White-BB width (% of price)", minval=0.1, step=0.05, group=gFilt)

riskPct    = input.float(1.0,  "Risk per trade %",   minval=0.1, step=0.1, group=gRisk)
leverage   = input.float(3.0,  "Leverage (moderate)", minval=1.0, maxval=10.0, step=0.5, group=gRisk)
slBuffer   = input.float(0.3,  "SL buffer (× sigma beyond red band)", minval=0.0, step=0.1, group=gRisk)
maxLossPct = input.float(1.0,  "Hard SL cap (% of price)", minval=0.2, step=0.1, group=gRisk)
useTP1Half = input.bool(true,  "Close 50% at MA20 (TP1)", group=gRisk)
useEODExit = input.bool(true,  "Force-exit before close (scalping)", group=gRisk)

sessionStr = input.session("0930-1545", "RTH session", group=gSess)
eodTime    = input.session("1555-1600", "EOD exit window", group=gSess)
cooldown   = input.int(2, "Cooldown bars after exit", minval=0, group=gSess)

// ---------- DOUBLE BOLLINGER BANDS ----------
redBasis   = ta.sma(open,  redLen)
redDev     = ta.stdev(open, redLen) * redMult
redUpper   = redBasis + redDev
redLower   = redBasis - redDev

whiteBasis = ta.sma(close, whiteLen)
whiteDev   = ta.stdev(close, whiteLen) * whiteMult
whiteUpper = whiteBasis + whiteDev
whiteLower = whiteBasis - whiteDev

// ---------- HTF TREND BIAS ----------
htfTrend() =>
    wb = ta.sma(close, whiteLen)
    [wb, close]
[htfBasis, htfClose] = request.security(syminfo.tickerid, htfInput, htfTrend(), lookahead=barmerge.lookahead_off)
htfBull = htfClose > htfBasis
htfBear = htfClose < htfBasis

// ---------- INDICATORS ----------
rsi      = ta.rsi(close, rsiLen)
volAvg   = ta.sma(volume, 20)
volOk    = not useVolume or volume > volAvg * volMult

bbWidthPct = (whiteUpper - whiteLower) / whiteBasis * 100
notSqueezed = not useSqueezeBlock or bbWidthPct >= squeezeMinPct

// ---------- SESSION ----------
inSession = not na(time(timeframe.period, sessionStr))
inEOD     = useEODExit and not na(time(timeframe.period, eodTime))

var int lastExitBar = -1000
cooldownOk = (bar_index - lastExitBar) > cooldown

// ---------- SIGNALS ----------
touchedLower = low  <= redLower
touchedUpper = high >= redUpper

bullReversal = touchedLower and close > open and close > redLower
bearReversal = touchedUpper and close < open and close < redUpper

flat     = strategy.position_size == 0
longSig  = bullReversal and rsi < rsiLongMax  and htfBull and notSqueezed and volOk and inSession and cooldownOk and flat
shortSig = bearReversal and rsi > rsiShortMin and htfBear and notSqueezed and volOk and inSession and cooldownOk and flat

// ---------- ORDERS ----------
var float entryP = na
var float slP    = na
var float tp1P   = na
var float tp2P   = na

sigmaSize = redDev / redMult

if longSig
    entryP := close
    slCalc  = redLower - sigmaSize * slBuffer
    slCap   = entryP * (1 - maxLossPct / 100)
    slP    := math.max(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteUpper
    riskPerUnit = entryP - slP
    rawQty = riskPerUnit > 0 ? (strategy.equity * riskPct / 100) / riskPerUnit : na
    maxQty = strategy.equity * leverage / entryP
    qty    = math.min(rawQty, maxQty)
    strategy.entry("LONG", strategy.long, qty=qty)

if shortSig
    entryP := close
    slCalc  = redUpper + sigmaSize * slBuffer
    slCap   = entryP * (1 + maxLossPct / 100)
    slP    := math.min(slCalc, slCap)
    tp1P   := whiteBasis
    tp2P   := whiteLower
    riskPerUnit = slP - entryP
    rawQty = riskPerUnit > 0 ? (strategy.equity * riskPct / 100) / riskPerUnit : na
    maxQty = strategy.equity * leverage / entryP
    qty    = math.min(rawQty, maxQty)
    strategy.entry("SHORT", strategy.short, qty=qty)

if strategy.position_size > 0
    if useTP1Half
        strategy.exit("TP1-L", "LONG", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-L", "LONG", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-L",  "LONG", limit=tp2P, stop=slP)

if strategy.position_size < 0
    if useTP1Half
        strategy.exit("TP1-S", "SHORT", qty_percent=50, limit=tp1P, stop=slP)
        strategy.exit("TP2-S", "SHORT", limit=tp2P, stop=slP)
    else
        strategy.exit("TP-S",  "SHORT", limit=tp2P, stop=slP)

if inEOD and strategy.position_size != 0
    strategy.close_all(comment="EOD")

if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index

// ---------- PLOTS ----------
plot(redUpper,   "Red Upper",   color=color.new(color.red, 20))
plot(redLower,   "Red Lower",   color=color.new(color.red, 20))
plot(whiteUpper, "White Upper", color=color.new(color.white, 0))
plot(whiteLower, "White Lower", color=color.new(color.white, 0))
plot(whiteBasis, "MA20 (TP1)",  color=color.new(color.yellow, 0), linewidth=2)

plotshape(longSig,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small, text="BUY")
plotshape(shortSig, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small, text="SELL")

bgcolor(inSession ? na : color.new(color.gray, 92))
bgcolor(notSqueezed ? na : color.new(color.purple, 90))

alertcondition(longSig,  "DBB Scalp LONG",  "DBB Scalp LONG {{ticker}} @ {{close}}")
alertcondition(shortSig, "DBB Scalp SHORT", "DBB Scalp SHORT {{ticker}} @ {{close}}")
