//@version=5
// NY Opening Setup - Backtest Strategy
// ------------------------------------
// Same setup as indicator/ny_daily_levels_ladder.pine, wired into TradingView's
// strategy tester so you can measure win rate, average R, and max drawdown before
// risking an FTMO challenge. Run on the 15-minute chart of US100 / US500, etc.
//
// One trade per day per symbol:
//   Candle 1 (first 15m of the NY session): big body, small wicks, body >= K x avg.
//   Candle 2: closes opposite to candle 1, retraces MIN%..MAX% of its body, AND
//             closes NEAR a day-range edge (between prev-day HIGH and NEXT HIGHER,
//             or between prev-day LOW and NEXT LOWER) - not in the middle.
//   Candle 3 (within the trigger window): price breaks candle 2's level in the
//             direction of candle 2 -> enter. Stop just beyond candle 1's extreme.
//   Exit: fixed reward:risk target, OR trail behind each new 15m candle, OR the
//         session close. Risk per trade is a % of equity; commission is modelled.

strategy("NY Opening Setup Strategy",
     shorttitle       = "NY Open Strat",
     overlay          = true,
     initial_capital  = 100000,
     default_qty_type = strategy.fixed,
     default_qty_value= 1,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     commission_type  = strategy.commission.cash_per_order,
     commission_value = 25,        // $ per order (entry and exit are each an order)
     slippage         = 0,
     max_lines_count  = 500,
     max_labels_count = 500)

// ---------- SETUP INPUTS (match the indicator) ----------
gSet = "Opening candle setup"
sess       = input.session("0930-1600", "New York regular session", group = gSet)
maxWickPct = input.float(35, "Candle 1: max wicks (% of candle range)", minval = 0, maxval = 100, step = 1, group = gSet)
bodyMult   = input.float(1.3, "Candle 1: body >= X times the average body", minval = 0.5, maxval = 10, step = 0.1, group = gSet)
bodyAvgLen = input.int(20, "Candle 1: average body over previous N candles", minval = 3, maxval = 200, group = gSet)
minRetr    = input.float(10, "Candle 2: min pullback (% of candle 1 body)", minval = 0, maxval = 100, step = 1, group = gSet)
maxRetr    = input.float(80, "Candle 2: max pullback (% of candle 1 body)", minval = 0, maxval = 100, step = 1, group = gSet)
reqOpp     = input.bool(true, "Candle 2 must close opposite to candle 1", group = gSet)
requireEdge = input.bool(true, "Candle 2 must close near a day-range edge (not the middle)", group = gSet)
edgeTolPct  = input.float(0.4, "Edge tolerance (% of price outside/inside the zone)", minval = 0, maxval = 5, step = 0.05, group = gSet)
lookback   = input.int(60, "Look back (days) for NEXT HIGHER / NEXT LOWER", minval = 1, maxval = 250, group = gSet)
trigSrc    = input.string("Candle 2 close", "Trigger level", options = ["Candle 2 close", "Candle 2 high/low"], group = gSet)
sigMode    = input.string("Reversal (follow candle 2)", "Signal direction", options = ["Reversal (follow candle 2)", "Continuation (follow candle 1)"], group = gSet)
trigWin    = input.int(3, "Trigger window (candles after candle 2)", minval = 1, maxval = 8, group = gSet)
openWin    = input.int(3, "Impulse candle within first N session candles", minval = 1, maxval = 12, group = gSet)
slBuf      = input.float(0.10, "Stop-loss: % beyond candle 1 extreme", minval = 0, maxval = 5, step = 0.05, group = gSet)

gRisk = "Risk & exits (FTMO)"
riskPct    = input.float(0.6, "Risk per trade (% of equity)", minval = 0.5, maxval = 1.0, step = 0.1, group = gRisk,
     tooltip = "Desired 0.6%. Lot rounding means the realised risk lands somewhere in the 0.5-1.0% band.")
exitMode   = input.string("Fixed R:R", "Exit style", options = ["Fixed R:R", "Trail behind 15m candle"], group = gRisk)
rr         = input.float(2.0, "Reward : Risk (fixed target)", minval = 0.5, maxval = 10, step = 0.1, group = gRisk)
closeEod   = input.bool(true, "Close any open trade at session end", group = gRisk)
maxDayLoss = input.float(5.0, "Stop trading for the day after this % equity loss", minval = 0.5, maxval = 20, step = 0.5, group = gRisk)

gNews = "News caution"
blockNews  = input.bool(false, "Block trades on news days", group = gNews)
autoNFP    = input.bool(true, "NFP = first Friday of month", group = gNews)
newsDates  = input.string("", "Extra news dates (YYYYMMDD, comma separated)", group = gNews)

tz = "America/New_York"

// ---------- SESSION / DAY DETECTION ----------
inSess   = not na(time(timeframe.period, sess, tz))
counting = timeframe.isintraday ? inSess : true
dayKey   = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay   = dayKey != nz(dayKey[1], -1)
startTrigger = counting and (newDay or not counting[1])
sessEnd  = counting[1] and not counting

var int barInDay = 0
if startTrigger
    barInDay := 1
else if counting
    barInDay += 1
else
    barInDay := 0

avgBody = ta.sma(math.abs(close - open), bodyAvgLen)

// news day?
isNFP  = dayofweek(time, tz) == dayofweek.friday and dayofmonth(time, tz) <= 7
inList = false
if newsDates != ""
    parts = str.split(newsDates, ",")
    for i = 0 to array.size(parts) - 1
        if str.tostring(dayKey) == str.trim(array.get(parts, i))
            inList := true
newsDay = (autoNFP and isNFP) or inList

// ---------- DAY LADDER (prev-day high/low + nearest higher/lower) ----------
var float dH = na
var float dL = na
var bool  dayActive = false
var float[] hist_H = array.new_float()
var float[] hist_L = array.new_float()
// levels valid for "today", set when the previous day finalises
var float pdHigh  = na
var float pdLow   = na
var float nHigher = na
var float nLower  = na

if dayActive and (startTrigger or not counting)
    float nh = na
    float nl = na
    n = array.size(hist_H)
    if n > 0
        for i = n - 1 to math.max(0, n - lookback)
            v = array.get(hist_H, i)
            w = array.get(hist_L, i)
            if v > dH and (na(nh) or v < nh)
                nh := v
            if w < dL and (na(nl) or w > nl)
                nl := w
    pdHigh  := dH
    pdLow   := dL
    nHigher := nh
    nLower  := nl
    array.push(hist_H, dH)
    array.push(hist_L, dL)
    while array.size(hist_H) > lookback
        array.shift(hist_H)
        array.shift(hist_L)
    dayActive := false

if startTrigger
    dayActive := true
    dH := high
    dL := low

if dayActive and counting
    dH := math.max(dH, high)
    dL := math.min(dL, low)

// ---------- SETUP STATE ----------
var bool  c1Ok    = false
var bool  c1Bull  = false
var float c1H     = na
var float c1L     = na
var float c1C     = na
var float c1Body  = na
var bool  c2Ok    = false
var float trig    = na
var bool  fired   = false
var float dayStartEquity = na
var bool  dayBlocked = false

if startTrigger
    c1Ok  := false
    c2Ok  := false
    fired := false
    trig  := na
    dayStartEquity := strategy.equity
    dayBlocked := false

// daily loss guard
if not na(dayStartEquity) and strategy.equity <= dayStartEquity * (1 - maxDayLoss / 100)
    dayBlocked := true

// impulse candle (candle 1) may appear on any of the first N session candles
var int c1pos = 0
if startTrigger
    c1pos := 0

qPos = barInDay - 1   // day-position of the just-closed candle (data is [1])

// search for candle 1
if not fired and not c2Ok and c1pos == 0 and qPos >= 1 and qPos <= openWin
    body1 = math.abs(close[1] - open[1])
    rng1  = high[1] - low[1]
    wick1 = rng1 > 0 ? (rng1 - body1) / rng1 * 100 : 100
    if rng1 > 0 and wick1 <= maxWickPct and body1 >= bodyMult * nz(avgBody[2])
        c1pos  := qPos
        c1Ok   := true
        c1Bull := close[1] > open[1]
        c1H    := high[1]
        c1L    := low[1]
        c1C    := close[1]
        c1Body := body1

tradeLong = sigMode == "Continuation (follow candle 1)" ? c1Bull : not c1Bull

// candle 2 = the candle right after candle 1
if c1pos > 0 and not c2Ok and not fired and qPos == c1pos + 1
    depth  = c1Bull ? (c1C - low[1]) / c1Body * 100 : (high[1] - c1C) / c1Body * 100
    oppOk  = not reqOpp or (c1Bull ? close[1] < open[1] : close[1] > open[1])
    c2close = close[1]
    tol     = c2close * edgeTolPct / 100
    inUpper = not na(pdHigh) and c2close >= pdHigh - tol and (na(nHigher) or c2close <= nHigher + tol)
    inLower = not na(pdLow)  and c2close <= pdLow  + tol and (na(nLower)  or c2close >= nLower  - tol)
    edgeOk  = not requireEdge or inUpper or inLower
    if depth >= minRetr and depth <= maxRetr and oppOk and edgeOk
        c2Ok := true
        trig := trigSrc == "Candle 2 close" ? close[1] : (tradeLong ? high[1] : low[1])
    else
        c1pos := 0
        c1Ok  := false

// trigger
inWindow  = c2Ok and barInDay >= c1pos + 2 and barInDay <= c1pos + 1 + trigWin
newsBlock = blockNews and newsDay
longSig  = inWindow and not fired and not dayBlocked and not newsBlock and tradeLong and high >= trig
shortSig = inWindow and not fired and not dayBlocked and not newsBlock and not tradeLong and low <= trig

// ---------- ENTRIES & EXITS ----------
var float stopPrice = na
var float tgtPrice  = na
var bool  posLong   = false

f_size(float fill, float stop) =>
    riskCash = strategy.equity * riskPct / 100
    perUnit  = math.abs(fill - stop)
    perUnit > 0 ? math.max(1, math.floor(riskCash / perUnit)) : 0

if longSig or shortSig
    fired     := true
    posLong   := longSig
    // orders execute on this bar's CLOSE, so size and target from the real fill
    fill      = close
    stopPrice := posLong ? c1L * (1 - slBuf / 100) : c1H * (1 + slBuf / 100)
    risk      = math.abs(fill - stopPrice)
    tgtPrice  := posLong ? fill + rr * risk : fill - rr * risk
    qty       = f_size(fill, stopPrice)
    if qty > 0
        if posLong
            strategy.entry("L", strategy.long, qty = qty)
        else
            strategy.entry("S", strategy.short, qty = qty)

// manage the open position
if strategy.position_size != 0
    if exitMode == "Fixed R:R"
        if posLong
            strategy.exit("xL", from_entry = "L", stop = stopPrice, limit = tgtPrice)
        else
            strategy.exit("xS", from_entry = "S", stop = stopPrice, limit = tgtPrice)
    else
        if posLong
            stopPrice := math.max(stopPrice, low[1])
            strategy.exit("xL", from_entry = "L", stop = stopPrice)
        else
            stopPrice := math.min(stopPrice, high[1])
            strategy.exit("xS", from_entry = "S", stop = stopPrice)

// close at session end
if closeEod and sessEnd and strategy.position_size != 0
    strategy.close_all(comment = "EOD")

// ---------- VISUALS ----------
plot(strategy.position_size != 0 ? stopPrice : na, "Stop", color = color.red, style = plot.style_linebr)
plot(strategy.position_size != 0 and exitMode == "Fixed R:R" ? tgtPrice : na, "Target", color = color.green, style = plot.style_linebr)
bgcolor(newsDay and blockNews ? color.new(color.orange, 90) : na)
