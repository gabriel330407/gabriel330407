//@version=5
// NY Daily Levels Ladder
// ----------------------
// For NYSE-listed stocks (New York time, regular session 09:30-16:00):
//   * Medium purple lines  -> each day's HIGH and LOW.
//   * Thick  purple lines  -> the "next" level beyond that day's range:
//        - the nearest PRIOR day high that sits ABOVE the day's high
//        - the nearest PRIOR day low  that sits BELOW the day's low
//     It does not matter how far away that level is - only the nearest one counts.
// The lines are drawn for every day and extended to the right, so the chart
// keeps the levels of the previous day, the day before that, and so on.
// The current (unfinished) day is drawn live and updated on every bar.

indicator("NY Daily Levels Ladder",
     shorttitle      = "NY D-H/L Ladder",
     overlay         = true,
     max_lines_count = 500)

// ---------- INPUTS ----------
gScope = "Scope"
onlyNyse   = input.bool(true, "Only stocks listed on the allowed exchanges", group = gScope)
exchList   = input.string("NYSE", "Allowed exchanges (comma separated)", group = gScope,
     tooltip = "Default: NYSE only. Add e.g. NYSE,NASDAQ,AMEX,ARCA to allow more US exchanges.")
sess       = input.session("0930-1600", "Regular session (New York time)", group = gScope)
rthOnly    = input.bool(true, "Regular session only (ignore pre/post market)", group = gScope)

gDraw = "Drawing"
lineColor   = input.color(#9C27B0, "Line color", group = gDraw)
midWidth    = input.int(2, "Day high/low width (medium)",  minval = 1, maxval = 6, group = gDraw)
thickWidth  = input.int(4, "Next higher/lower width (thick)", minval = 1, maxval = 10, group = gDraw)
extendRight = input.bool(true, "Extend lines to the right", group = gDraw)
showLive    = input.bool(true, "Draw the current day live", group = gDraw)
daysKeep    = input.int(20, "Days to keep on chart", minval = 1, maxval = 120, group = gDraw)
searchDays  = input.int(120, "Days to search for next higher/lower level", minval = 1, maxval = 500, group = gDraw,
     tooltip = "How many previous days are scanned when looking for the nearest prior high above / low below the day's range.")

tz = "America/New_York"

// ---------- EXCHANGE / SYMBOL FILTER ----------
f_exchangeAllowed() =>
    ok = not onlyNyse
    if onlyNyse
        parts = str.split(str.upper(exchList), ",")
        for i = 0 to array.size(parts) - 1
            if str.trim(array.get(parts, i)) == str.upper(syminfo.exchange)
                ok := true
    ok

allowed = syminfo.type == "stock" and f_exchangeAllowed()

var table info = table.new(position.top_right, 1, 1)
if barstate.islast and not allowed
    table.cell(info, 0, 0,
         "NY Daily Levels Ladder is inactive:\nsymbol is not a stock on " + exchList + " (this is " + syminfo.exchange + " / " + syminfo.type + ")",
         text_color = color.white, bgcolor = color.new(#9C27B0, 20), text_size = size.small)

// ---------- SESSION / DAY DETECTION (New York time) ----------
inSess   = not na(time(timeframe.period, sess, tz))
counting = allowed and (timeframe.isintraday and rthOnly ? inSess : true)

dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = dayKey != nz(dayKey[1], -1)

// A day starts on the first counted bar of a new NY calendar day
// (or the first bar back inside the session when the previous bar was outside it).
startTrigger = counting and (newDay or not counting[1])

// ---------- STATE ----------
var float dH        = na      // running high of the active day
var float dL        = na      // running low  of the active day
var int   dStart    = na      // time of the first bar of the active day
var int   dEnd      = na      // time of the last counted bar of the active day
var bool  dayActive = false

var float[] hist_H  = array.new_float()   // completed day highs (newest last)
var float[] hist_L  = array.new_float()   // completed day lows  (newest last)

var line[] lnH  = array.new_line()
var line[] lnL  = array.new_line()
var line[] lnNH = array.new_line()
var line[] lnNL = array.new_line()

var line liveH  = na
var line liveL  = na
var line liveNH = na
var line liveNL = na

// ---------- HELPERS ----------
// nearest stored level strictly ABOVE ref (na when none)
f_nextAbove(float[] arr, float ref) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v > ref and (na(best) or v < best)
                best := v
    best

// nearest stored level strictly BELOW ref (na when none)
f_nextBelow(float[] arr, float ref) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v < ref and (na(best) or v > best)
                best := v
    best

f_newLine(int x1, int x2, float y, int w) =>
    line.new(x1, y, x2, y,
         xloc   = xloc.bar_time,
         extend = extendRight ? extend.right : extend.none,
         color  = lineColor,
         width  = w)

f_safeDelete(line ln) =>
    if not na(ln)
        line.delete(ln)

f_trimLines(line[] arr) =>
    while array.size(arr) > daysKeep
        f_safeDelete(array.shift(arr))

// ---------- MAIN ----------
// close the previous day when a new one starts, or when we leave the session
if dayActive and (startTrigger or not counting)
    nhF = f_nextAbove(hist_H, dH)
    nlF = f_nextBelow(hist_L, dL)

    // permanent lines for the completed day
    array.push(lnH, f_newLine(dStart, dEnd, dH, midWidth))
    array.push(lnL, f_newLine(dStart, dEnd, dL, midWidth))
    array.push(lnNH, na(nhF) ? line(na) : f_newLine(dStart, dEnd, nhF, thickWidth))
    array.push(lnNL, na(nlF) ? line(na) : f_newLine(dStart, dEnd, nlF, thickWidth))
    f_trimLines(lnH)
    f_trimLines(lnL)
    f_trimLines(lnNH)
    f_trimLines(lnNL)

    // remember the day's high/low for the next-level search
    array.push(hist_H, dH)
    array.push(hist_L, dL)
    while array.size(hist_H) > searchDays
        array.shift(hist_H)
        array.shift(hist_L)

    // the live lines are replaced by the permanent ones
    f_safeDelete(liveH)
    f_safeDelete(liveL)
    f_safeDelete(liveNH)
    f_safeDelete(liveNL)
    liveH  := na
    liveL  := na
    liveNH := na
    liveNL := na
    dayActive := false

// open a new day
if startTrigger
    dayActive := true
    dH        := high
    dL        := low
    dStart    := time
    dEnd      := time

// accumulate the active day
if dayActive and counting
    dH   := math.max(dH, high)
    dL   := math.min(dL, low)
    dEnd := time

    if showLive
        nh = f_nextAbove(hist_H, dH)
        nl = f_nextBelow(hist_L, dL)

        if na(liveH)
            liveH := f_newLine(dStart, dEnd, dH, midWidth)
            liveL := f_newLine(dStart, dEnd, dL, midWidth)
        else
            line.set_xy1(liveH, dStart, dH)
            line.set_xy2(liveH, dEnd, dH)
            line.set_xy1(liveL, dStart, dL)
            line.set_xy2(liveL, dEnd, dL)

        if na(nh)
            f_safeDelete(liveNH)
            liveNH := na
        else if na(liveNH)
            liveNH := f_newLine(dStart, dEnd, nh, thickWidth)
        else
            line.set_xy1(liveNH, dStart, nh)
            line.set_xy2(liveNH, dEnd, nh)

        if na(nl)
            f_safeDelete(liveNL)
            liveNL := na
        else if na(liveNL)
            liveNL := f_newLine(dStart, dEnd, nl, thickWidth)
        else
            line.set_xy1(liveNL, dStart, nl)
            line.set_xy2(liveNL, dEnd, nl)
