//@version=5
// NY Daily Levels Ladder  (15-minute chart, New York session 09:30-16:00)
// -----------------------------------------------------------------------
// Exactly FOUR purple lines on the chart at any time:
//   * 2 MEDIUM lines -> the HIGH and LOW of the previous day.
//   * 2 THICK  lines -> looking back at the earlier days, the nearest
//                       day-high ABOVE that high and the nearest day-low
//                       BELOW that low (distance does not matter).
// Every line starts at the bar where that high / low was made and extends
// to the right. When a new day starts, the four old lines are deleted and
// four new ones are drawn. Nothing that is out of date stays on the chart.
//
// OPENING CANDLE SETUP (labels + alerts):
//   Candle 1 (first 15m candle of the day): big body, wicks <= X% of range,
//             body >= K x the average body of the previous candles.
//   Candle 2: a decent pullback, retracing between MIN% and MAX% of candle 1's body.
//   Candle 3: as soon as price passes candle 2's close (or high/low) in the
//             direction of candle 2 (the reversal bar; a "Continuation" mode
//             follows candle 1 instead)
//             -> BUY / SELL label, stop-loss label + line just beyond candle 1's
//                extreme, and a live "% to stop" label that follows the price.

indicator("NY Daily Levels Ladder",
     shorttitle      = "NY D-H/L Ladder",
     overlay         = true,
     scale            = scale.right,      // draw on the same price scale as the candles
     max_lines_count  = 500,
     max_labels_count = 500)

// ---------- INPUTS ----------
gRule = "Rule"
sess      = input.session("0930-1600", "New York regular session", group = gRule)
rthOnly   = input.bool(true, "Use regular session only for the day high/low", group = gRule)
lookback  = input.int(60, "Look back (days before the previous day)", minval = 1, maxval = 250, group = gRule,
     tooltip = "How many earlier days are scanned for the nearest higher high / lower low. Set 2 to look at only the two days before.")
tfOnly    = input.string("15", "Run only on this chart timeframe (empty = any)", group = gRule)

gDraw = "Drawing"
lineColor  = input.color(#9C27B0, "Line color", group = gDraw)
midWidth   = input.int(2, "Previous day high/low width (medium)", minval = 1, maxval = 6, group = gDraw)
thickWidth = input.int(4, "Next higher/lower width (thick)", minval = 1, maxval = 10, group = gDraw)
showStatus = input.bool(true, "Show status box", group = gDraw)
statusSize = input.string("large", "Status box text size", options = ["small", "normal", "large", "huge"], group = gDraw)

gSet = "Opening candle setup"
setupOn    = input.bool(true, "Enable opening candle setup", group = gSet)
maxWickPct = input.float(20, "Candle 1: max wicks (% of candle range)", minval = 0, maxval = 100, step = 1, group = gSet)
bodyMult   = input.float(2.0, "Candle 1: body must be >= X times the average body", minval = 0.5, maxval = 10, step = 0.1, group = gSet)
bodyAvgLen = input.int(20, "Candle 1: average body over previous N candles", minval = 3, maxval = 200, group = gSet)
minRetr    = input.float(20, "Candle 2: min pullback (% of candle 1 body)", minval = 0, maxval = 100, step = 1, group = gSet)
maxRetr    = input.float(60, "Candle 2: max pullback (% of candle 1 body)", minval = 0, maxval = 100, step = 1, group = gSet)
trigSrc    = input.string("Candle 2 close", "Candle 3 trigger level", options = ["Candle 2 close", "Candle 2 high/low"], group = gSet)
sigMode    = input.string("Reversal (follow candle 2)", "Signal direction", options = ["Reversal (follow candle 2)", "Continuation (follow candle 1)"], group = gSet,
     tooltip = "Reversal: trade in the direction of candle 2, the pullback bar. Continuation: trade in the direction of candle 1.")
waitMin    = input.bool(false, "Wait 1 minute into candle 3 before signalling (real-time only)", group = gSet)
slBuf      = input.float(0.10, "Stop-loss: % beyond candle 1 extreme", minval = 0, maxval = 5, step = 0.05, group = gSet)
showChecks = input.bool(true, "Mark candle 1 / candle 2 when they pass", group = gSet)

tz = "America/New_York"

// ---------- SESSION / DAY DETECTION (New York time) ----------
tfOk     = tfOnly == "" or timeframe.period == tfOnly
inSess   = not na(time(timeframe.period, sess, tz))
counting = tfOk and (timeframe.isintraday and rthOnly ? inSess : true)

dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = dayKey != nz(dayKey[1], -1)

// first counted bar of a new New York day
startTrigger = counting and (newDay or not counting[1])

// ---------- STATE ----------
var int   daysDone  = 0
var float dH        = na       // running high of the day being built
var float dL        = na       // running low  of the day being built
var int   dHbar     = na       // bar where that high was made
var int   dLbar     = na       // bar where that low  was made
var bool  dayActive = false

var float[] hist_H    = array.new_float()   // completed day highs (newest last)
var float[] hist_L    = array.new_float()   // completed day lows  (newest last)
var int[]   hist_Hbar = array.new_int()     // bar of each stored high
var int[]   hist_Lbar = array.new_int()     // bar of each stored low

// the only four lines on the chart
var line lnH  = na
var line lnL  = na
var line lnNH = na
var line lnNL = na

// ---------- HELPERS ----------
f_newLine(int x1, float y, int w) =>
    line.new(x1, y, bar_index, y,
         xloc   = xloc.bar_index,
         extend = extend.right,
         color  = lineColor,
         width  = w)

f_safeDelete(line ln) =>
    if not na(ln)
        line.delete(ln)

f_extendTo(line ln, int x2) =>
    if not na(ln)
        line.set_x2(ln, x2)

// ---------- MAIN ----------
// the day being built is finished: it becomes the "previous day"
if dayActive and (startTrigger or not counting)
    // look back for the nearest higher high / lower low
    int   iH  = -1
    int   iL  = -1
    float nh  = na
    float nl  = na
    n = array.size(hist_H)
    if n > 0
        for i = n - 1 to math.max(0, n - lookback)
            v = array.get(hist_H, i)
            w = array.get(hist_L, i)
            if v > dH
                if na(nh) or v < nh
                    nh := v
                    iH := i
            if w < dL
                if na(nl) or w > nl
                    nl := w
                    iL := i

    // delete the old four lines
    f_safeDelete(lnH)
    f_safeDelete(lnL)
    f_safeDelete(lnNH)
    f_safeDelete(lnNL)

    // medium lines: previous day high / low, from the bar where they were made
    lnH := f_newLine(dHbar, dH, midWidth)
    lnL := f_newLine(dLbar, dL, midWidth)
    // thick lines: nearest higher high / lower low, from the bar where they were made
    lnNH := iH < 0 ? line(na) : f_newLine(array.get(hist_Hbar, iH), nh, thickWidth)
    lnNL := iL < 0 ? line(na) : f_newLine(array.get(hist_Lbar, iL), nl, thickWidth)

    // store this day
    array.push(hist_H, dH)
    array.push(hist_L, dL)
    array.push(hist_Hbar, dHbar)
    array.push(hist_Lbar, dLbar)
    while array.size(hist_H) > lookback
        array.shift(hist_H)
        array.shift(hist_L)
        array.shift(hist_Hbar)
        array.shift(hist_Lbar)

    daysDone  += 1
    dayActive := false

// start building a new day
if startTrigger
    dayActive := true
    dH        := high
    dL        := low
    dHbar     := bar_index
    dLbar     := bar_index

// accumulate the day being built, remembering where the high / low were made
if dayActive and counting
    if high > dH
        dH    := high
        dHbar := bar_index
    if low < dL
        dL    := low
        dLbar := bar_index

// keep the four lines stretched to the newest bar
f_extendTo(lnH,  bar_index)
f_extendTo(lnL,  bar_index)
f_extendTo(lnNH, bar_index)
f_extendTo(lnNL, bar_index)

// ---------- OPENING CANDLE SETUP ----------
// position of the bar inside the trading day (1 = first 15m candle)
var int barInDay = 0
if startTrigger
    barInDay := 1
else if counting
    barInDay += 1
else
    barInDay := 0

avgBody = ta.sma(math.abs(close - open), bodyAvgLen)

// candle 1 facts (stored on candle 2, when candle 1 is closed)
var bool  c1Ok   = false
var bool  c1Bull = false
var float c1O    = na
var float c1H    = na
var float c1L    = na
var float c1C    = na
var float c1Body = na
// candle 2 facts (stored on candle 3, when candle 2 is closed)
var bool  c2Ok   = false
var float trig   = na
var bool  fired  = false

// per-day drawings
var line  slLine  = na
var label liveLbl = na
var float slLevel = na
var bool  isLong  = false

if startTrigger
    c1Ok  := false
    c2Ok  := false
    fired := false
    trig  := na

// --- candle 1 check (evaluated on the second candle of the day) ---
if setupOn and barInDay == 2
    body1 = math.abs(close[1] - open[1])
    rng1  = high[1] - low[1]
    wick1 = rng1 > 0 ? (rng1 - body1) / rng1 * 100 : 100
    c1Ok   := rng1 > 0 and wick1 <= maxWickPct and body1 >= bodyMult * nz(avgBody[2])
    c1Bull := close[1] > open[1]
    c1O    := open[1]
    c1H    := high[1]
    c1L    := low[1]
    c1C    := close[1]
    c1Body := body1
    if c1Ok and showChecks
        label.new(bar_index - 1, c1Bull ? low[1] : high[1], "1",
             style = c1Bull ? label.style_label_up : label.style_label_down,
             color = color.new(#9C27B0, 0), textcolor = color.white, size = size.tiny)

// direction of the trade: candle 2 is the pullback, so it points opposite to candle 1
tradeLong = sigMode == "Continuation (follow candle 1)" ? c1Bull : not c1Bull

// --- candle 2 check (evaluated on the third candle of the day) ---
if setupOn and barInDay == 3 and c1Ok
    depth = c1Bull ? (c1C - low[1]) / c1Body * 100 : (high[1] - c1C) / c1Body * 100
    c2Ok := depth >= minRetr and depth <= maxRetr
    trig := trigSrc == "Candle 2 close" ? close[1] : (tradeLong ? high[1] : low[1])
    if c2Ok and showChecks
        label.new(bar_index - 1, c1Bull ? low[1] : high[1], "2",
             style = c1Bull ? label.style_label_up : label.style_label_down,
             color = color.new(#9C27B0, 0), textcolor = color.white, size = size.tiny)

// --- candle 3 trigger ---
timeOk   = not waitMin or (timenow - time >= 60000)
crossUp  = tradeLong and high >= trig
crossDn  = not tradeLong and low <= trig
longSig  = setupOn and barInDay == 3 and c2Ok and not fired and timeOk and crossUp
shortSig = setupOn and barInDay == 3 and c2Ok and not fired and timeOk and crossDn

if longSig or shortSig
    fired   := true
    isLong  := longSig
    slLevel := isLong ? c1L * (1 - slBuf / 100) : c1H * (1 + slBuf / 100)
    entryTxt = (isLong ? "BUY " : "SELL ") + str.tostring(trig, format.mintick)
    label.new(bar_index, isLong ? low : high, entryTxt,
         style = isLong ? label.style_label_up : label.style_label_down,
         color = isLong ? color.new(#00C853, 0) : color.new(#D50000, 0),
         textcolor = color.white, size = size.normal)
    label.new(bar_index, slLevel, "SL " + str.tostring(slLevel, format.mintick),
         style = label.style_label_left,
         color = color.new(#D50000, 0), textcolor = color.white, size = size.small)
    slLine := line.new(bar_index, slLevel, bar_index + 1, slLevel,
         xloc = xloc.bar_index, color = color.new(#D50000, 0), width = 1, style = line.style_dashed)
    alert((isLong ? "LONG" : "SHORT") + " opening setup on " + syminfo.ticker +
         " entry " + str.tostring(trig, format.mintick) + " stop " + str.tostring(slLevel, format.mintick),
         alert.freq_once_per_bar)

// --- live "% to stop" label, follows the price until the day ends ---
active = fired and counting and not na(slLevel)
if active
    pct = isLong ? (close - slLevel) / close * 100 : (slLevel - close) / close * 100
    txt = "To stop: " + str.tostring(pct, "#.##") + "%"
    if na(liveLbl)
        liveLbl := label.new(bar_index + 2, slLevel, txt, style = label.style_label_left,
             color = color.new(#D50000, 20), textcolor = color.white, size = size.normal)
    else
        label.set_xy(liveLbl, bar_index + 2, slLevel)
        label.set_text(liveLbl, txt)
    if not na(slLine)
        line.set_x2(slLine, bar_index)
else if not na(liveLbl)
    label.delete(liveLbl)
    liveLbl := na

alertcondition(longSig,  "Opening setup LONG",  "Opening setup LONG on {{ticker}}")
alertcondition(shortSig, "Opening setup SHORT", "Opening setup SHORT on {{ticker}}")

// ---------- STATUS BOX ----------
var table info = table.new(position.top_right, 1, 1)
if barstate.islast and showStatus
    txt = not tfOk ? "NY Daily Levels Ladder\nHidden: chart is " + timeframe.period + ", set to run on " + tfOnly :
         "NY Daily Levels Ladder\n" +
         "Completed days: " + str.tostring(daysDone) + "\n" +
         "Prev day high: " + (na(lnH)  ? "-" : str.tostring(line.get_y1(lnH),  format.mintick)) + "\n" +
         "Prev day low: "  + (na(lnL)  ? "-" : str.tostring(line.get_y1(lnL),  format.mintick)) + "\n" +
         "Next higher: "   + (na(lnNH) ? "-" : str.tostring(line.get_y1(lnNH), format.mintick)) + "\n" +
         "Next lower: "    + (na(lnNL) ? "-" : str.tostring(line.get_y1(lnNL), format.mintick))
    tsize = statusSize == "small" ? size.small : statusSize == "normal" ? size.normal : statusSize == "huge" ? size.huge : size.large
    table.cell(info, 0, 0, txt, text_color = color.white, bgcolor = color.new(#9C27B0, 30),
         text_size = tsize, text_halign = text.align_left)
