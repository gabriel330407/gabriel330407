//@version=5
// NY Daily Levels Ladder  (15-minute chart, New York session 09:30-16:00)
// -----------------------------------------------------------------------
// Exactly FOUR purple lines on the chart at any time:
//   * 2 MEDIUM lines -> the HIGH and LOW of the previous day.
//   * 2 THICK  lines -> looking back at the earlier days, the nearest
//                       day-high ABOVE that high and the nearest day-low
//                       BELOW that low (distance does not matter).
// Every line starts at the bar where that high / low was made and extends
// to the right. When a new day starts, the four old lines are deleted and
// four new ones are drawn. Nothing that is out of date stays on the chart.

indicator("NY Daily Levels Ladder",
     shorttitle      = "NY D-H/L Ladder",
     overlay         = true,
     scale           = scale.right,      // draw on the same price scale as the candles
     max_lines_count = 8)

// ---------- INPUTS ----------
gRule = "Rule"
sess      = input.session("0930-1600", "New York regular session", group = gRule)
rthOnly   = input.bool(true, "Use regular session only for the day high/low", group = gRule)
lookback  = input.int(60, "Look back (days before the previous day)", minval = 1, maxval = 250, group = gRule,
     tooltip = "How many earlier days are scanned for the nearest higher high / lower low. Set 2 to look at only the two days before.")
tfOnly    = input.string("15", "Run only on this chart timeframe (empty = any)", group = gRule)

gDraw = "Drawing"
lineColor  = input.color(#9C27B0, "Line color", group = gDraw)
midWidth   = input.int(2, "Previous day high/low width (medium)", minval = 1, maxval = 6, group = gDraw)
thickWidth = input.int(4, "Next higher/lower width (thick)", minval = 1, maxval = 10, group = gDraw)
showStatus = input.bool(true, "Show status box", group = gDraw)
statusSize = input.string("large", "Status box text size", options = ["small", "normal", "large", "huge"], group = gDraw)

tz = "America/New_York"

// ---------- SESSION / DAY DETECTION (New York time) ----------
tfOk     = tfOnly == "" or timeframe.period == tfOnly
inSess   = not na(time(timeframe.period, sess, tz))
counting = tfOk and (timeframe.isintraday and rthOnly ? inSess : true)

dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = dayKey != nz(dayKey[1], -1)

// first counted bar of a new New York day
startTrigger = counting and (newDay or not counting[1])

// ---------- STATE ----------
var int   daysDone  = 0
var float dH        = na       // running high of the day being built
var float dL        = na       // running low  of the day being built
var int   dHbar     = na       // bar where that high was made
var int   dLbar     = na       // bar where that low  was made
var bool  dayActive = false

var float[] hist_H    = array.new_float()   // completed day highs (newest last)
var float[] hist_L    = array.new_float()   // completed day lows  (newest last)
var int[]   hist_Hbar = array.new_int()     // bar of each stored high
var int[]   hist_Lbar = array.new_int()     // bar of each stored low

// the only four lines on the chart
var line lnH  = na
var line lnL  = na
var line lnNH = na
var line lnNL = na

// ---------- HELPERS ----------
f_newLine(int x1, float y, int w) =>
    line.new(x1, y, bar_index, y,
         xloc   = xloc.bar_index,
         extend = extend.right,
         color  = lineColor,
         width  = w)

f_safeDelete(line ln) =>
    if not na(ln)
        line.delete(ln)

f_extendTo(line ln, int x2) =>
    if not na(ln)
        line.set_x2(ln, x2)

// ---------- MAIN ----------
// the day being built is finished: it becomes the "previous day"
if dayActive and (startTrigger or not counting)
    // look back for the nearest higher high / lower low
    int   iH  = -1
    int   iL  = -1
    float nh  = na
    float nl  = na
    n = array.size(hist_H)
    if n > 0
        for i = n - 1 to math.max(0, n - lookback)
            v = array.get(hist_H, i)
            w = array.get(hist_L, i)
            if v > dH
                if na(nh) or v < nh
                    nh := v
                    iH := i
            if w < dL
                if na(nl) or w > nl
                    nl := w
                    iL := i

    // delete the old four lines
    f_safeDelete(lnH)
    f_safeDelete(lnL)
    f_safeDelete(lnNH)
    f_safeDelete(lnNL)

    // medium lines: previous day high / low, from the bar where they were made
    lnH := f_newLine(dHbar, dH, midWidth)
    lnL := f_newLine(dLbar, dL, midWidth)
    // thick lines: nearest higher high / lower low, from the bar where they were made
    lnNH := iH < 0 ? line(na) : f_newLine(array.get(hist_Hbar, iH), nh, thickWidth)
    lnNL := iL < 0 ? line(na) : f_newLine(array.get(hist_Lbar, iL), nl, thickWidth)

    // store this day
    array.push(hist_H, dH)
    array.push(hist_L, dL)
    array.push(hist_Hbar, dHbar)
    array.push(hist_Lbar, dLbar)
    while array.size(hist_H) > lookback
        array.shift(hist_H)
        array.shift(hist_L)
        array.shift(hist_Hbar)
        array.shift(hist_Lbar)

    daysDone  += 1
    dayActive := false

// start building a new day
if startTrigger
    dayActive := true
    dH        := high
    dL        := low
    dHbar     := bar_index
    dLbar     := bar_index

// accumulate the day being built, remembering where the high / low were made
if dayActive and counting
    if high > dH
        dH    := high
        dHbar := bar_index
    if low < dL
        dL    := low
        dLbar := bar_index

// keep the four lines stretched to the newest bar
f_extendTo(lnH,  bar_index)
f_extendTo(lnL,  bar_index)
f_extendTo(lnNH, bar_index)
f_extendTo(lnNL, bar_index)

// ---------- STATUS BOX ----------
var table info = table.new(position.top_right, 1, 1)
if barstate.islast and showStatus
    txt = not tfOk ? "NY Daily Levels Ladder\nHidden: chart is " + timeframe.period + ", set to run on " + tfOnly :
         "NY Daily Levels Ladder\n" +
         "Completed days: " + str.tostring(daysDone) + "\n" +
         "Prev day high: " + (na(lnH)  ? "-" : str.tostring(line.get_y1(lnH),  format.mintick)) + "\n" +
         "Prev day low: "  + (na(lnL)  ? "-" : str.tostring(line.get_y1(lnL),  format.mintick)) + "\n" +
         "Next higher: "   + (na(lnNH) ? "-" : str.tostring(line.get_y1(lnNH), format.mintick)) + "\n" +
         "Next lower: "    + (na(lnNL) ? "-" : str.tostring(line.get_y1(lnNL), format.mintick))
    tsize = statusSize == "small" ? size.small : statusSize == "normal" ? size.normal : statusSize == "huge" ? size.huge : size.large
    table.cell(info, 0, 0, txt, text_color = color.white, bgcolor = color.new(#9C27B0, 30),
         text_size = tsize, text_halign = text.align_left)
