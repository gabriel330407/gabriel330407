//@version=5
// NY Daily Levels Ladder
// ----------------------
// For any stock traded during the New York session (09:30-16:00 New York time).
// Exactly FOUR lines are on the chart at any time, all purple:
//   * 2 medium lines -> the HIGH and LOW of the last completed day.
//   * 2 thick  lines -> the "next" level beyond that day's range:
//        - the nearest earlier day high that sits ABOVE that day's high
//        - the nearest earlier day low  that sits BELOW that day's low
//     It does not matter how far away that level is - only the nearest one counts.
// When a new day starts, the four old lines are deleted and four new ones are
// drawn for the day that just finished, so the ladder moves forward day by day.

indicator("NY Daily Levels Ladder",
     shorttitle      = "NY D-H/L Ladder",
     overlay         = true,
     max_lines_count = 8)

// ---------- INPUTS ----------
gScope = "Scope"
sess       = input.session("0930-1600", "Regular session (New York time)", group = gScope)
rthOnly    = input.bool(true, "Regular session only (ignore pre/post market)", group = gScope)

gDraw = "Drawing"
lineColor   = input.color(#9C27B0, "Line color", group = gDraw)
midWidth    = input.int(2, "Day high/low width (medium)",  minval = 1, maxval = 6, group = gDraw)
thickWidth  = input.int(4, "Next higher/lower width (thick)", minval = 1, maxval = 10, group = gDraw)
showStatus  = input.bool(true, "Show status box", group = gDraw)
statusSize  = input.string("large", "Status box text size", options = ["small", "normal", "large", "huge"], group = gDraw)
searchDays  = input.int(120, "Days to search for next higher/lower level", minval = 1, maxval = 500, group = gDraw,
     tooltip = "How many earlier days are scanned when looking for the nearest high above / low below the day's range.")

tz = "America/New_York"

symExchange = syminfo.prefix
symType     = syminfo.type

var table info = table.new(position.top_right, 1, 1)

// ---------- SESSION / DAY DETECTION (New York time) ----------
inSess   = not na(time(timeframe.period, sess, tz))
counting = timeframe.isintraday and rthOnly ? inSess : true

dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = dayKey != nz(dayKey[1], -1)

// A day starts on the first counted bar of a new NY calendar day
// (or the first bar back inside the session when the previous bar was outside it).
startTrigger = counting and (newDay or not counting[1])

// ---------- STATE ----------
var int   daysDone  = 0
var float dH        = na      // running high of the active day
var float dL        = na      // running low  of the active day
var int   dStart    = na      // bar index of the first bar of the active day
var bool  dayActive = false

var float[] hist_H  = array.new_float()   // completed day highs (newest last)
var float[] hist_L  = array.new_float()   // completed day lows  (newest last)

// the only four lines on the chart
var line lnH  = na
var line lnL  = na
var line lnNH = na
var line lnNL = na

// ---------- HELPERS ----------
// nearest stored level strictly ABOVE ref (na when none)
f_nextAbove(float[] arr, float ref) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v > ref and (na(best) or v < best)
                best := v
    best

// nearest stored level strictly BELOW ref (na when none)
f_nextBelow(float[] arr, float ref) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v < ref and (na(best) or v > best)
                best := v
    best

f_newLine(int x1, float y, int w) =>
    line.new(x1, y, bar_index, y,
         xloc   = xloc.bar_index,
         extend = extend.right,
         color  = lineColor,
         width  = w)

f_extendTo(line ln, int x2) =>
    if not na(ln)
        line.set_x2(ln, x2)

f_safeDelete(line ln) =>
    if not na(ln)
        line.delete(ln)

// ---------- MAIN ----------
// the active day is finished: replace the four lines with this day's levels
if dayActive and (startTrigger or not counting)
    nh = f_nextAbove(hist_H, dH)
    nl = f_nextBelow(hist_L, dL)

    // delete the old four lines
    f_safeDelete(lnH)
    f_safeDelete(lnL)
    f_safeDelete(lnNH)
    f_safeDelete(lnNL)

    // draw the new four lines (thick ones only when an earlier level exists)
    lnH  := f_newLine(dStart, dH, midWidth)
    lnL  := f_newLine(dStart, dL, midWidth)
    lnNH := na(nh) ? line(na) : f_newLine(dStart, nh, thickWidth)
    lnNL := na(nl) ? line(na) : f_newLine(dStart, nl, thickWidth)

    // remember this day's high/low for the next-level search
    array.push(hist_H, dH)
    array.push(hist_L, dL)
    while array.size(hist_H) > searchDays
        array.shift(hist_H)
        array.shift(hist_L)

    daysDone  += 1
    dayActive := false

// open a new day
if startTrigger
    dayActive := true
    dH        := high
    dL        := low
    dStart    := bar_index

// accumulate the active day
if dayActive and counting
    dH := math.max(dH, high)
    dL := math.min(dL, low)

// keep the four lines anchored to their price and stretched to the latest bar
f_extendTo(lnH,  bar_index)
f_extendTo(lnL,  bar_index)
f_extendTo(lnNH, bar_index)
f_extendTo(lnNL, bar_index)

// ---------- STATUS BOX ----------
if barstate.islast and showStatus
    txt = "NY Daily Levels Ladder\n" +
         "Exchange: " + symExchange + "  Type: " + symType + "\n" +
         "Completed days: " + str.tostring(daysDone) + "\n" +
         "Day high: "  + (na(lnH)  ? "-" : str.tostring(line.get_y1(lnH),  format.mintick)) + "\n" +
         "Day low: "   + (na(lnL)  ? "-" : str.tostring(line.get_y1(lnL),  format.mintick)) + "\n" +
         "Next high: " + (na(lnNH) ? "-" : str.tostring(line.get_y1(lnNH), format.mintick)) + "\n" +
         "Next low: "  + (na(lnNL) ? "-" : str.tostring(line.get_y1(lnNL), format.mintick))
    tsize = statusSize == "small" ? size.small : statusSize == "normal" ? size.normal : statusSize == "huge" ? size.huge : size.large
    table.cell(info, 0, 0, txt, text_color = color.white, bgcolor = color.new(#9C27B0, 30),
         text_size = tsize, text_halign = text.align_left)
