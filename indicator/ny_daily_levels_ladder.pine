//@version=5
// NY Daily Levels Ladder  (15-minute chart, New York session 09:30-16:00)
// -----------------------------------------------------------------------
// Rule, applied every day:
//   1. Take the HIGH and LOW of the PREVIOUS day  -> purple MEDIUM lines.
//   2. Look back N days before that (default 2) and find the nearest
//      day-high ABOVE that high and the nearest day-low BELOW that low
//      (distance does not matter, only the nearest)  -> purple THICK lines.
// Each day shows its own four levels; when a new day starts the levels are
// recalculated, so you always see four lines for the current day.

indicator("NY Daily Levels Ladder",
     shorttitle = "NY D-H/L Ladder",
     overlay    = true)

// ---------- INPUTS ----------
gRule = "Rule"
sess      = input.session("0930-1600", "New York regular session", group = gRule)
rthOnly   = input.bool(true, "Use regular session only for the day high/low", group = gRule)
lookback  = input.int(2, "Look back (days before the previous day)", minval = 1, maxval = 100, group = gRule,
     tooltip = "How many earlier days are scanned for the nearest higher high / lower low.")
tfOnly    = input.string("15", "Run only on this chart timeframe (empty = any)", group = gRule)

gDraw = "Drawing"
lineColor  = input.color(#9C27B0, "Line color", group = gDraw)
midWidth   = input.int(2, "Previous day high/low width (medium)", minval = 1, maxval = 6, group = gDraw)
thickWidth = input.int(4, "Next higher/lower width (thick)", minval = 1, maxval = 10, group = gDraw)
showStatus = input.bool(true, "Show status box", group = gDraw)
statusSize = input.string("large", "Status box text size", options = ["small", "normal", "large", "huge"], group = gDraw)

tz = "America/New_York"

// ---------- SESSION / DAY DETECTION (New York time) ----------
tfOk     = tfOnly == "" or timeframe.period == tfOnly
inSess   = not na(time(timeframe.period, sess, tz))
counting = timeframe.isintraday and rthOnly ? inSess : true

dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = dayKey != nz(dayKey[1], -1)

// first counted bar of a new New York day
startTrigger = counting and (newDay or not counting[1])

// ---------- STATE ----------
var int   daysDone  = 0
var float dH        = na       // running high of the day being built
var float dL        = na       // running low  of the day being built
var bool  dayActive = false

var float[] hist_H = array.new_float()   // completed day highs (newest last)
var float[] hist_L = array.new_float()   // completed day lows  (newest last)

// the four levels currently shown
var float lvlH  = na    // previous day high   (medium)
var float lvlL  = na    // previous day low    (medium)
var float lvlNH = na    // nearest higher high (thick)
var float lvlNL = na    // nearest lower low   (thick)

finalized = false

// ---------- MAIN ----------
// the day being built is finished: it becomes the "previous day"
if dayActive and (startTrigger or not counting)
    float nh = na
    float nl = na
    n = array.size(hist_H)
    if n > 0
        for i = n - 1 to math.max(0, n - lookback)
            v = array.get(hist_H, i)
            w = array.get(hist_L, i)
            if v > dH and (na(nh) or v < nh)
                nh := v
            if w < dL and (na(nl) or w > nl)
                nl := w

    lvlH  := dH
    lvlL  := dL
    lvlNH := nh
    lvlNL := nl

    array.push(hist_H, dH)
    array.push(hist_L, dL)
    while array.size(hist_H) > 200
        array.shift(hist_H)
        array.shift(hist_L)

    daysDone  += 1
    dayActive := false
    finalized := true

// start building a new day
if startTrigger
    dayActive := true
    dH        := high
    dL        := low

// accumulate the day being built
if dayActive and counting
    dH := math.max(dH, high)
    dL := math.min(dL, low)

// ---------- DRAWING ----------
// break the line where the level changes, so days are not joined by a vertical step
show = tfOk and not startTrigger and not finalized

plot(show ? lvlH  : na, "Previous day high", color = lineColor, linewidth = midWidth,   style = plot.style_linebr)
plot(show ? lvlL  : na, "Previous day low",  color = lineColor, linewidth = midWidth,   style = plot.style_linebr)
plot(show ? lvlNH : na, "Next higher high",  color = lineColor, linewidth = thickWidth, style = plot.style_linebr)
plot(show ? lvlNL : na, "Next lower low",    color = lineColor, linewidth = thickWidth, style = plot.style_linebr)

// ---------- STATUS BOX ----------
var table info = table.new(position.top_right, 1, 1)
if barstate.islast and showStatus
    txt = not tfOk ? "NY Daily Levels Ladder\nHidden: chart is " + timeframe.period + ", set to run on " + tfOnly :
         "NY Daily Levels Ladder\n" +
         "Completed days: " + str.tostring(daysDone) + "\n" +
         "Prev day high: "  + (na(lvlH)  ? "-" : str.tostring(lvlH,  format.mintick)) + "\n" +
         "Prev day low: "   + (na(lvlL)  ? "-" : str.tostring(lvlL,  format.mintick)) + "\n" +
         "Next higher: "    + (na(lvlNH) ? "-" : str.tostring(lvlNH, format.mintick)) + "\n" +
         "Next lower: "     + (na(lvlNL) ? "-" : str.tostring(lvlNL, format.mintick))
    tsize = statusSize == "small" ? size.small : statusSize == "normal" ? size.normal : statusSize == "huge" ? size.huge : size.large
    table.cell(info, 0, 0, txt, text_color = color.white, bgcolor = color.new(#9C27B0, 30),
         text_size = tsize, text_halign = text.align_left)
