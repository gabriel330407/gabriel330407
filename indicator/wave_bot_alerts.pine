//@version=5
// WaveBot Alerts - Per-Chart Alert Indicator with Trailing Stop
// Apply to each of your 8 chart tabs (one Forex pair per chart).
// Emits structured JSON alerts for entry, trailing updates, and exits.

indicator("WaveBot Alerts",
     shorttitle = "WaveBot Alerts",
     overlay    = true,
     max_labels_count = 500)

// ---------- INPUTS ----------
gCore = "Core"
gRisk = "Risk"
gFilt = "Filters"
gSess = "Session"
gHook = "Webhook"

htfInput  = input.timeframe("240", "Higher TF",  options=["60","120","240","360","D"], group=gCore)
minScore  = input.int(5, "Min Score (of 6)", minval=3, maxval=6, group=gCore)

tpPct       = input.float(3.0, "TP %", minval=0.5, step=0.1, group=gRisk)
slPct       = input.float(1.5, "SL %", minval=0.3, step=0.1, group=gRisk)
sizePct     = input.float(30,  "Size %", minval=1, maxval=100, group=gRisk)
useTrail    = input.bool(true, "ATR Trailing Stop", group=gRisk)
trailMult   = input.float(2.0, "Trail ATR Multiplier", minval=0.5, step=0.1, group=gRisk)
trailActPct = input.float(1.2, "Activate Trail After (% profit)", minval=0.1, step=0.1, group=gRisk)

adxThresh  = input.float(22, "ADX Minimum", minval=10, group=gFilt)
atrMaxMult = input.float(1.5,"Max ATR vs 50-avg", minval=1, step=0.1, group=gFilt)

useSession = input.bool(true, "Session filter", group=gSess)
sessionStr = input.session("1200-1700", "Session", group=gSess)
noFriPM    = input.bool(true, "Block Friday after 15:00", group=gSess)
cooldown   = input.int(3, "Cooldown bars", minval=0, group=gSess)

botId      = input.string("", "Bot ID (for webhook)", group=gHook)

// ---------- INDICATORS ----------
emaF = ta.ema(close, 50)
emaS = ta.ema(close, 200)
rsi  = ta.rsi(close, 14)
[macdLine, sigLine, macdHist] = ta.macd(close, 12, 26, 9)
[diP, diM, adx] = ta.dmi(14, 14)
atrV   = ta.atr(14)
atrAvg = ta.sma(atrV, 50)
stKRaw = ta.stoch(close, high, low, 14)
stK    = ta.sma(stKRaw, 3)
stD    = ta.sma(stK, 3)

// ---------- HTF ----------
htfCalc() =>
    ef = ta.ema(close, 50)
    es = ta.ema(close, 200)
    [ef, es]

[htfEmaF, htfEmaS] = request.security(syminfo.tickerid, htfInput, htfCalc(), lookahead=barmerge.lookahead_off)

htfBull = htfEmaF > htfEmaS and close > htfEmaS
htfBear = htfEmaF < htfEmaS and close < htfEmaS

// ---------- SESSION / COOLDOWN ----------
inSession = not useSession or not na(time(timeframe.period, sessionStr))
okFriday  = not (noFriPM and dayofweek == dayofweek.friday and hour >= 15)
timeOk    = inSession and okFriday

var int lastExitBar = -1000
cooldownOk = (bar_index - lastExitBar) > cooldown

// ---------- SCORING ----------
volOk = atrV < atrAvg * atrMaxMult

lT = (emaF > emaS and close > emaF) ? 1 : 0
lH = htfBull ? 1 : 0
lR = (rsi >= 40 and rsi <= 65) ? 1 : 0
lM = (macdLine > sigLine and macdHist > nz(macdHist[1], 0)) ? 1 : 0
lA = (adx > adxThresh and diP > diM) ? 1 : 0
lS = (ta.crossover(stK, stD) and stK < 80) ? 1 : 0
longScore = lT + lH + lR + lM + lA + lS

sT = (emaF < emaS and close < emaF) ? 1 : 0
sH = htfBear ? 1 : 0
sR = (rsi >= 35 and rsi <= 60) ? 1 : 0
sM = (macdLine < sigLine and macdHist < nz(macdHist[1], 0)) ? 1 : 0
sA = (adx > adxThresh and diM > diP) ? 1 : 0
sS = (ta.crossunder(stK, stD) and stK > 20) ? 1 : 0
shortScore = sT + sH + sR + sM + sA + sS

// ---------- VIRTUAL POSITION STATE ----------
var string posSide = "FLAT"
var float  entryP  = na
var float  slP     = na
var float  tpP     = na
var float  trailP  = na
var bool   trailOn = false

longEntry  = posSide == "FLAT" and longScore  >= minScore and volOk and timeOk and cooldownOk
shortEntry = posSide == "FLAT" and shortScore >= minScore and volOk and timeOk and cooldownOk

// ---------- OPEN POSITIONS ----------
if longEntry and barstate.isconfirmed
    posSide := "LONG"
    entryP  := close
    slP     := close * (1 - slPct / 100)
    tpP     := close * (1 + tpPct / 100)
    trailP  := slP
    trailOn := false
    alert('{"bot":"' + botId + '","action":"BUY","pair":"' + syminfo.ticker + '","entry":' + str.tostring(close) + ',"sl":' + str.tostring(slP) + ',"tp":' + str.tostring(tpP) + ',"size_pct":' + str.tostring(sizePct) + '}', alert.freq_once_per_bar_close)

if shortEntry and barstate.isconfirmed
    posSide := "SHORT"
    entryP  := close
    slP     := close * (1 + slPct / 100)
    tpP     := close * (1 - tpPct / 100)
    trailP  := slP
    trailOn := false
    alert('{"bot":"' + botId + '","action":"SELL","pair":"' + syminfo.ticker + '","entry":' + str.tostring(close) + ',"sl":' + str.tostring(slP) + ',"tp":' + str.tostring(tpP) + ',"size_pct":' + str.tostring(sizePct) + '}', alert.freq_once_per_bar_close)

// ---------- TRAILING STOP ----------
if useTrail and posSide == "LONG" and not na(entryP)
    profitPct = (close - entryP) / entryP * 100
    if profitPct >= trailActPct and not trailOn
        trailOn := true
        alert('{"bot":"' + botId + '","action":"TRAIL_ON","pair":"' + syminfo.ticker + '"}', alert.freq_once_per_bar_close)
    if trailOn
        newT = close - atrV * trailMult
        if newT > nz(trailP, newT - 1)
            trailP := newT
            alert('{"bot":"' + botId + '","action":"TRAIL_UPDATE","pair":"' + syminfo.ticker + '","trail":' + str.tostring(trailP) + '}', alert.freq_once_per_bar_close)

if useTrail and posSide == "SHORT" and not na(entryP)
    profitPct = (entryP - close) / entryP * 100
    if profitPct >= trailActPct and not trailOn
        trailOn := true
        alert('{"bot":"' + botId + '","action":"TRAIL_ON","pair":"' + syminfo.ticker + '"}', alert.freq_once_per_bar_close)
    if trailOn
        newT = close + atrV * trailMult
        if newT < nz(trailP, newT + 1)
            trailP := newT
            alert('{"bot":"' + botId + '","action":"TRAIL_UPDATE","pair":"' + syminfo.ticker + '","trail":' + str.tostring(trailP) + '}', alert.freq_once_per_bar_close)

// ---------- EXIT CHECKS ----------
if posSide == "LONG"
    effSL = (useTrail and trailOn) ? math.max(slP, trailP) : slP
    if low <= effSL
        reason = (trailOn and effSL > slP) ? "TRAIL" : "SL"
        alert('{"bot":"' + botId + '","action":"CLOSE_LONG","pair":"' + syminfo.ticker + '","reason":"' + reason + '","exit":' + str.tostring(effSL) + '}', alert.freq_once_per_bar_close)
        posSide     := "FLAT"
        lastExitBar := bar_index
        trailOn     := false
    if high >= tpP and posSide == "LONG"
        alert('{"bot":"' + botId + '","action":"CLOSE_LONG","pair":"' + syminfo.ticker + '","reason":"TP","exit":' + str.tostring(tpP) + '}', alert.freq_once_per_bar_close)
        posSide     := "FLAT"
        lastExitBar := bar_index
        trailOn     := false

if posSide == "SHORT"
    effSL = (useTrail and trailOn) ? math.min(slP, trailP) : slP
    if high >= effSL
        reason = (trailOn and effSL < slP) ? "TRAIL" : "SL"
        alert('{"bot":"' + botId + '","action":"CLOSE_SHORT","pair":"' + syminfo.ticker + '","reason":"' + reason + '","exit":' + str.tostring(effSL) + '}', alert.freq_once_per_bar_close)
        posSide     := "FLAT"
        lastExitBar := bar_index
        trailOn     := false
    if low <= tpP and posSide == "SHORT"
        alert('{"bot":"' + botId + '","action":"CLOSE_SHORT","pair":"' + syminfo.ticker + '","reason":"TP","exit":' + str.tostring(tpP) + '}', alert.freq_once_per_bar_close)
        posSide     := "FLAT"
        lastExitBar := bar_index
        trailOn     := false

// ---------- PLOTS ----------
plot(emaF, "EMA50",  color=color.new(color.aqua, 0))
plot(emaS, "EMA200", color=color.new(color.orange, 0), linewidth=2)

plotshape(longEntry,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small, text="BUY")
plotshape(shortEntry, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small, text="SELL")

longSLplot  = (posSide == "LONG"  and useTrail and trailOn) ? math.max(slP, trailP) : (posSide == "LONG"  ? slP : na)
shortSLplot = (posSide == "SHORT" and useTrail and trailOn) ? math.min(slP, trailP) : (posSide == "SHORT" ? slP : na)

plot(posSide != "FLAT" ? tpP : na, "TP", color=color.green, style=plot.style_linebr)
plot(longSLplot,  "SL Long",  color=color.red, style=plot.style_linebr)
plot(shortSLplot, "SL Short", color=color.red, style=plot.style_linebr)

bgcolor(timeOk ? na : color.new(color.gray, 92))

// ---------- INFO TABLE ----------
var table t = table.new(position.top_right, 2, 12, border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "WaveBot",      bgcolor=color.new(color.blue, 40), text_color=color.white)
    table.cell(t, 1, 0, syminfo.ticker, bgcolor=color.new(color.blue, 40), text_color=color.white)
    table.cell(t, 0, 1, "HTF")
    table.cell(t, 1, 1, htfBull ? "BULL" : htfBear ? "BEAR" : "FLAT", text_color=htfBull ? color.lime : htfBear ? color.red : color.gray)
    table.cell(t, 0, 2, "ADX")
    table.cell(t, 1, 2, str.tostring(adx, "#.#"), text_color=adx > adxThresh ? color.lime : color.gray)
    table.cell(t, 0, 3, "RSI")
    table.cell(t, 1, 3, str.tostring(rsi, "#.#"))
    table.cell(t, 0, 4, "Vol")
    table.cell(t, 1, 4, volOk ? "OK" : "HIGH", text_color=volOk ? color.lime : color.red)
    table.cell(t, 0, 5, "Session")
    table.cell(t, 1, 5, timeOk ? "OPEN" : "CLOSED", text_color=timeOk ? color.lime : color.red)
    table.cell(t, 0, 6, "Long")
    table.cell(t, 1, 6, str.tostring(longScore) + "/6", text_color=longScore >= minScore ? color.lime : color.gray)
    table.cell(t, 0, 7, "Short")
    table.cell(t, 1, 7, str.tostring(shortScore) + "/6", text_color=shortScore >= minScore ? color.red : color.gray)
    table.cell(t, 0, 8, "Position")
    table.cell(t, 1, 8, posSide, text_color=posSide == "LONG" ? color.lime : posSide == "SHORT" ? color.red : color.gray)
    table.cell(t, 0, 9, "Entry")
    table.cell(t, 1, 9, posSide != "FLAT" ? str.tostring(entryP, "#.#####") : "-")
    table.cell(t, 0, 10, "TP/SL")
    table.cell(t, 1, 10, posSide != "FLAT" ? str.tostring(tpP, "#.#####") + "/" + str.tostring(slP, "#.#####") : "-")
    table.cell(t, 0, 11, "Trail")
    table.cell(t, 1, 11, trailOn ? str.tostring(trailP, "#.#####") : "OFF", text_color=trailOn ? color.yellow : color.gray)

// ---------- ALERT CONDITIONS (UI shortcuts) ----------
alertcondition(longEntry,  "WaveBot LONG entry",  "WaveBot LONG on {{ticker}}")
alertcondition(shortEntry, "WaveBot SHORT entry", "WaveBot SHORT on {{ticker}}")
